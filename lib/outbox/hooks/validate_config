#!/usr/bin/env ruby
# frozen_string_literal: true
# pre-receive hook for the _config staging repo. Refuses a push whose
# outbox.conf cannot be read or has entries the outbox would not use, so a
# broken configuration never reaches review. Reads "<old> <new> <ref>" lines.
require_relative "../git"
require_relative "../repo"
require_relative "../config"

# New objects are still in quarantine; git must be told where they are.
QUARANTINE = ENV.slice("GIT_DIR", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_QUARANTINE_PATH")

failed = false
$stdin.each_line do |line|
  _old, new, ref = line.split
  next if new.nil? || new.match?(/\A0+\z/) || !ref.start_with?("refs/heads/")
  problems = Outbox::Config.problems_in(new, env: QUARANTINE)
  next if problems.empty?
  failed = true
  warn "outbox: #{ref}: #{Outbox::Config::FILE} is not valid:"
  problems.each { |p| warn "  - #{p}" }
end
exit(failed ? 1 : 0)
