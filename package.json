{
  "name": "outbox-assets",
  "private": true,
  "description": "Browser bundle for the diff viewer. `rake assets` builds it into public/diffs (gitignored).",
  "scripts": {
    "build": "esbuild diffs=assets/diffs.js browse=assets/browse.js worker=node_modules/@pierre/diffs/dist/worker/worker.js --bundle --format=esm --splitting --minify --outdir=public/diffs --log-level=warning"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.5.2",
    "@playwright/test": "^1.64.1",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fzy.js": "^0.4.1",
    "marked": "^18.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
