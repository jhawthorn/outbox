<% files = patch.files %>
<% if files.empty? %>
  <p class="empty">No changes.</p>
<% else %>
  <div class="patch-summary">
    <span class="muted"><%= h patch.stat %></span>
    <ul>
    <% files.each_with_index do |f, i| %>
      <li>
        <a href="#f<%= i %>"><%= hv f.path %></a>
        <% if (label = file_status_label(f)) %><span class="badge <%= f.status %>"><%= label %></span><% end %>
        <% if f.binary? %><span class="badge deleted">binary, not reviewable</span><% else %>
          <span class="count add">+<%= f.additions %></span>
          <span class="count del">−<%= f.deletions %></span>
          <% if f.truncated? %><span class="badge deleted">cut off, not fully shown</span><% end %>
        <% end %>
      </li>
    <% end %>
    </ul>
    <% if patch.truncated? %>
      <div class="panel danger" style="margin:10px 0 0">
        <strong>This patch is bigger than <%= Outbox::Repo::MAX_PATCH_BYTES / 1_000_000 %> MB and was cut off.</strong>
        Files past that point are not listed at all. Do not approve from this page; review commit by commit or pull the branch locally.
      </div>
    <% end %>
  </div>

  <% files.each_with_index do |f, i| %>
    <details class="file" id="f<%= i %>" open>
      <summary>
        <code><%= hv f.path %></code>
        <% if f.renamed? || f.status == :copied %><span class="muted">← <code><%= hv f.old_path %></code></span><% end %>
        <% if (label = file_status_label(f)) %><span class="badge <%= f.status %>"><%= label %></span><% end %>
        <% if f.old_mode && f.new_mode && f.status == :modified %><span class="muted">mode <%= h f.old_mode %> → <%= h f.new_mode %></span><% end %>
        <% unless f.binary? %>
          <span class="count add">+<%= f.additions %></span>
          <span class="count del">−<%= f.deletions %></span>
        <% end %>
      </summary>
      <% if f.binary? %>
        <p style="padding:8px 12px;margin:0;color:var(--bad)">Binary file. Its contents cannot be reviewed here; approving includes it unseen.</p>
      <% elsif f.hunks.empty? %>
        <p class="muted" style="padding:8px 12px;margin:0">No content changes.</p>
      <% else %>
        <table class="hunks">
        <% f.hunks.each do |hk| %>
          <tr class="hunk"><td class="no"></td><td class="no"></td><td class="code"><%= h hk.header %></td></tr>
          <% hk.lines.each do |l| %>
            <% if l.note? %>
              <tr class="note"><td class="no"></td><td class="no"></td><td class="code"><%= h l.text %></td></tr>
            <% else %>
              <tr class="<%= l.kind %>">
                <td class="no"><%= l.old_no %></td>
                <td class="no"><%= l.new_no %></td>
                <td class="code"><span class="mark"><%= l.add? ? "+" : (l.del? ? "−" : " ") %></span><%= hv l.text %></td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
        </table>
        <% if f.truncated? %>
          <p style="padding:8px 12px;margin:0;color:var(--bad)">Cut off after <%= Outbox::Diff::MAX_LINES_PER_FILE %> lines. The rest of this file's changes are not shown.</p>
        <% end %>
      <% end %>
    </details>
  <% end %>
<% end %>
