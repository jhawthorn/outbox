<% files = patch.files %>
<% blob_url = "#{repo_url(@repo)}/blobs" %>
<% if ignore_whitespace? %>
  <div class="panel warn ws-note">Whitespace changes are hidden, including indentation, which can change what code means. <a href="<%= h whitespace_url(false) %>">Show them</a></div>
<% end %>
<% if files.empty? %>
  <p class="empty">No changes<%= " besides whitespace" if ignore_whitespace? %>.</p>
<% else %>
  <div class="patch-summary">
    <span class="muted"><%= h patch.stat %></span> · <a href="<%= patch_url %>">raw patch</a>
    · <% if ignore_whitespace? %><a href="<%= h whitespace_url(false) %>">show whitespace changes</a><% else %><a href="<%= h whitespace_url(true) %>" title="Diff with git diff -w">hide whitespace changes</a><% end %>
    <details class="file-list"<%= " open" if files.size <= 12 %>>
      <summary><%= files.size <= 12 ? "Files" : "All #{files.size} files" %></summary>
      <ul>
      <% files.each_with_index do |f, i| %>
        <li>
          <a class="path" href="#f<%= i %>" title="<%= h f.path %>"><%= hv f.path %></a>
          <span class="tags">
            <% if (label = file_status_label(f)) %><span class="badge <%= f.status %>"><%= label %></span><% end %>
            <% if f.hidden_lines.any? %><span class="badge hidden">hidden characters</span><% end %>
          </span>
          <span class="counts"><% if f.binary? %><span class="muted">binary</span><% else %><span class="count add">+<%= f.additions %></span> <span class="count del">−<%= f.deletions %></span><% end %></span>
          <span class="view"><% if rev && f.new_blob && !f.binary? %><a class="muted" href="<%= tree_url(@repo, rev, f.path) %>" title="View the whole file at this commit">view file</a><% end %></span>
        </li>
      <% end %>
      </ul>
    </details>
    <% if patch.truncated? %>
      <div class="panel warn" style="margin:10px 0 0">Diff truncated at <%= Outbox::Repo::MAX_PATCH_BYTES / 1_000_000 %> MB.</div>
    <% end %>
    <% unless diffs_built? %>
      <div class="panel warn" style="margin:10px 0 0">The diff viewer is not built. Run <code>rake assets</code> (needs pnpm), or read the <a href="<%= patch_url %>">raw patch</a>.</div>
    <% end %>
  </div>

  <div class="patch" data-patch-url="<%= patch_url %>" data-blob-url="<%= blob_url %>">
  <% files.each_with_index do |f, i| %>
    <%# What the browser's file headers show besides the path and counts (diffs.js). %>
    <details class="file" id="f<%= i %>" open data-path="<%= h f.path %>"<% if f.old_blob %> data-old-blob="<%= f.old_blob %>"<% end %><% if f.new_blob %> data-new-blob="<%= f.new_blob %>"<% end %><% if f.binary? %> data-binary<% end %><% if image?(f.path) %> data-image<% end %><% if f.mode_change? %> data-mode="<%= h f.old_mode %> → <%= h f.new_mode %>"<% end %><% if f.hidden_lines.any? %> data-hidden="<%= h f.hidden_lines.join(", ") %>"<% end %> data-status="<%= f.status || "modified" %>"<% unless f.binary? %> data-add="<%= f.additions %>" data-del="<%= f.deletions %>"<% end %><% if rev && f.new_blob && !f.binary? %> data-view-url="<%= h tree_url(@repo, rev, f.path) %>"<% end %>>
      <summary>
        <code><%= hv f.path %></code>
        <% if f.renamed? || f.status == :copied %><span class="muted">← <code><%= hv f.old_path %></code></span><% end %>
        <% if (label = file_status_label(f)) %><span class="badge <%= f.status %>"><%= label %></span><% end %>
        <% if f.mode_change? %><span class="muted">mode <%= h f.old_mode %> → <%= h f.new_mode %></span><% end %>
        <% unless f.binary? %>
          <span class="count add">+<%= f.additions %></span>
          <span class="count del">−<%= f.deletions %></span>
        <% end %>
        <% if f.hidden_lines.any? %>
          <span class="badge hidden" title="Zero-width, bidi or control characters on lines <%= h f.hidden_lines.join(", ") %>">hidden characters on <%= pluralize(f.hidden_lines.size, "line") %></span>
        <% end %>
      </summary>
      <% if f.binary? && image?(f.path) %>
        <div class="image-diff">
          <% name = ERB::Util.url_encode(File.basename(f.path)) %>
          <% if f.old_blob %><figure class="before"><img src="<%= blob_url %>/<%= f.old_blob %>/<%= name %>" alt="<%= h f.path %>, before"><% if f.new_blob %><figcaption class="muted">before</figcaption><% end %></figure><% end %>
          <% if f.new_blob %><figure class="after"><img src="<%= blob_url %>/<%= f.new_blob %>/<%= name %>" alt="<%= h f.path %>, after"><% if f.old_blob %><figcaption class="muted">after</figcaption><% end %></figure><% end %>
        </div>
      <% elsif f.binary? %>
        <p class="muted" style="padding:8px 12px;margin:0">Binary file not shown.</p>
      <% elsif f.empty? %>
        <p class="muted" style="padding:8px 12px;margin:0">No content changes.</p>
      <% else %>
        <div class="diff" data-diff-file="<%= h f.path %>">
          <noscript>JavaScript is off. <a href="<%= patch_url %>">View the raw patch.</a></noscript>
        </div>
      <% end %>
    </details>
  <% end %>
  </div>
  <% if diffs_built? %><script type="module" src="/diffs/diffs.js"></script><% end %>
<% end %>
