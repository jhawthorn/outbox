<% @title = @repo.name %>
<% fetch = %(<form class="inline" method="post" action="#{repo_url(@repo)}/fetch"><input type="hidden" name="back" value="#{h request.path}"><button type="submit"#{" disabled" if @status.busy?}>Fetch upstream</button></form>) %>
<%= erb :_repo_head, layout: false, locals: { tab: "code", actions: fetch } %>
<%= erb :_job_status, layout: false %>

<%# Staged work, pointed out; the list itself is the Review tab. %>
<% pending = @branches.select(&:pending?) %>
<% unless pending.empty? %>
  <div class="pending-note">
    <span><b><%= pluralize(pending.size, "branch", "branches") %></b> awaiting review:
      <% pending.first(3).each_with_index do |b, i| %><%= ", " if i > 0 %><a href="<%= branch_url(@repo, b.name) %>"><%= h b.name %></a> <span class="badge <%= b.status %>"><%= status_label(b) %></span><% end %><%= ", …" if pending.size > 3 %></span>
    <span class="spacer"></span>
    <a class="button" href="<%= review_url(@repo) %>">Review</a>
  </div>
<% end %>

<% if @tree_error %>
  <div class="panel warn">The code could not be shown: <%= h @tree_error %></div>
<% elsif @rev %>
  <%= erb :_tree, layout: false %>
<% elsif !@status.busy? %>
  <p class="empty">No code yet. Push something to <code><%= h clone_url(@repo) %></code>.</p>
<% end %>
