<% @title = @repo.name %>
<h1><%= h @repo.name %></h1>

<div class="toolbar">
  <span class="muted">upstream <code><%= h @repo.upstream_url %></code></span>
  <span class="muted">clone <code><%= h clone_url(@repo) %></code></span>
  <span class="spacer"></span>
  <form class="inline" method="post" action="<%= repo_url(@repo) %>/fetch">
    <button type="submit" <%= "disabled" if @status.busy? %>>Fetch upstream</button>
  </form>
  <form class="inline" method="post" action="<%= repo_url(@repo) %>/destroy"
        onsubmit="return confirm('Remove <%= h @repo.name %> from the outbox? Upstream is not touched.')">
    <button type="submit" class="danger" <%= "disabled" if @status.busy? %>>Remove</button>
  </form>
</div>

<details class="add" style="margin:0 0 16px" <%= "open" if @status.last && !@status.last.ok? && @status.last.job != :discard %>>
  <summary>Deploy key for pushing to upstream</summary>
  <% if @repo.public_key %>
    <p class="muted" style="margin:8px 0">Generated inside the outbox for this repository only. Add it to the upstream
      as a deploy key <strong>with write access</strong>
      <% if (url = github_keys_url(@repo.upstream_url)) %>at <a href="<%= h url %>" target="_blank" rel="noopener"><%= h url %></a><% end %>.
      Pushes to upstream use this key and nothing else.</p>
    <pre style="white-space:pre-wrap;word-break:break-all;margin:0"><%= h @repo.public_key %></pre>
  <% else %>
    <p class="muted" style="margin:8px 0">No deploy key was generated (ssh-keygen was not available when this
      repository was added). Pushes use whatever SSH setup the server's environment provides.</p>
  <% end %>
</details>

<% if @status.running? %>
  <div class="panel">
    <span class="badge busy">working</span>
    <%= h job_label(@status) %> <span class="muted">(<%= duration(@status.elapsed) %>)</span>
    <% if @status.queued > 1 %><span class="muted">· <%= @status.queued - 1 %> more queued</span><% end %>
    <% if @status.progress %><div class="progress"><%= h @status.progress %></div><% end %>
  </div>
<% elsif @status.busy? %>
  <div class="panel"><span class="badge busy">queued</span> starting shortly</div>
<% elsif @status.last && !@status.last.ok? %>
  <div class="panel danger">
    <span class="badge failed"><%= h @status.last.job %> failed</span>
    <% if @status.last.branch %>on <code><%= h @status.last.branch %></code><% end %>
    <pre style="margin:8px 0 0;white-space:pre-wrap"><%= h @status.last.message %></pre>
  </div>
<% elsif @status.last %>
  <p class="muted"><%= h @status.last.message %>.</p>
<% end %>

<% if @branches.empty? %>
  <% unless @status.busy? %>
    <p class="empty">No branches. Push something to <code><%= h clone_url(@repo) %></code>.</p>
  <% end %>
<% else %>
  <table>
    <thead><tr><th>Branch</th><th>Status</th><th>Staged</th><th>Upstream</th><th></th></tr></thead>
    <tbody>
    <% @branches.sort_by { |b| [b.pending? ? 0 : 1, b.name] }.each do |b| %>
      <tr>
        <td>
          <% if b.pending? %>
            <a href="<%= branch_url(@repo, b.name) %>"><%= h b.name %></a>
          <% else %>
            <%= h b.name %>
          <% end %>
        </td>
        <td>
          <span class="badge <%= b.status %>"><%= status_label(b.status) %></span>
          <div class="muted" style="font-size:13px"><%= h summary(b) %></div>
        </td>
        <td><code><%= short(b.staged) %></code></td>
        <td><code><%= short(b.upstream) %></code></td>
        <td class="actions">
          <% if b.pending? %>
            <a href="<%= branch_url(@repo, b.name) %>">Review</a>
            <% unless b.needs_force? %>
              <form class="inline" method="post" action="<%= branch_url(@repo, b.name) %>/approve">
                <input type="hidden" name="expected" value="<%= b.staged %>">
                <button type="submit" class="primary">Approve</button>
              </form>
            <% end %>
            <form class="inline" method="post" action="<%= branch_url(@repo, b.name) %>/discard"
                  onsubmit="return confirm('Discard staged changes on <%= h b.name %>?')">
              <input type="hidden" name="expected" value="<%= b.staged %>">
              <button type="submit" class="danger">Discard</button>
            </form>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>
