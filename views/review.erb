<% @title = "Review · #{@repo.name}" %>
<% fetch = %(<form class="inline" method="post" action="#{repo_url(@repo)}/fetch"><input type="hidden" name="back" value="#{h request.path}"><button type="submit"#{" disabled" if @status.busy?}>Fetch upstream</button></form>) %>
<%= erb :_repo_head, layout: false, locals: { tab: "review", actions: fetch } %>
<%= erb :_remotes, layout: false %>
<%= erb :_job_status, layout: false, locals: { quiet_success: false } %>

<% pending = @branches.select(&:pending?) %>
<% synced = @branches.size - pending.size %>

<% if @branches.empty? %>
  <% unless @status.busy? %>
    <p class="empty">No branches. Push something to <code><%= h clone_url(@repo) %></code>.</p>
  <% end %>
<% elsif pending.empty? %>
  <div class="nothing">
    <p>Nothing to review: <a href="<%= repo_url(@repo) %>/branches"><%= pluralize(synced, "branch", "branches") %></a> in sync with upstream.</p>
    <% if (code = @repo.default_rev) %>
      <a class="button" href="<%= tree_url(@repo, code.name) %>">Browse code</a>
      <a class="button" href="<%= history_url(@repo, code.name) %>">Recent commits</a>
    <% end %>
  </div>
<% else %>
  <table class="pending">
    <thead><tr><th>Branch</th><th>Status</th><th class="latest">Latest commit</th><th></th></tr></thead>
    <tbody>
    <% pending.each do |b| %>
      <tr>
        <td><a class="branch-name" href="<%= branch_url(@repo, b.name) %>"><%= h b.name %></a></td>
        <td class="state">
          <span class="badge <%= b.status %>"><%= status_label(b) %></span>
          <div class="muted" style="font-size:13px"><%= h summary(b) %> · <%= committed_label(b.time) %></div>
        </td>
        <td class="latest">
          <% if (tip = @latest[b.name]) %>
            <a class="subject" href="<%= show_commit_url(@repo, tip.sha) %>" title="<%= h tip.subject %>"><%= hv tip.subject %></a>
            <div class="muted"><%= hv tip.author %> · <code title="<%= tips_label(b).gsub(/<[^>]+>/, "") %>"><%= short(b.staged || b.upstream)[0, 7] %></code></div>
          <% end %>
        </td>
        <td><div class="actions">
          <a class="button" href="<%= branch_url(@repo, b.name) %>">Review</a>
          <% unless b.needs_force? %>
            <form class="inline" method="post" action="<%= branch_url(@repo, b.name) %>/approve">
              <input type="hidden" name="expected" value="<%= b.staged %>">
              <button type="submit" class="primary">Approve</button>
            </form>
          <% end %>
          <form class="inline" method="post" action="<%= branch_url(@repo, b.name) %>/discard"
                data-confirm="Discard staged changes on <%= h b.name %>?">
            <input type="hidden" name="expected" value="<%= b.staged %>">
            <button type="submit" class="danger">Discard</button>
          </form>
        </div></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <% if synced > 0 %>
    <p class="muted" style="margin-top:8px"><a href="<%= repo_url(@repo) %>/branches"><%= pluralize(synced, "other branch", "other branches") %></a> in sync with upstream.</p>
  <% end %>
<% end %>

