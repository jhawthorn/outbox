<%# The review comments on a commit shown on its own (Repo#comments): it was %>
<%# a branch's staged tip when they were written. Lines the commit has link %>
<%# to its diff below; removed ones were in the diff the reviewer read then. %>
<% unless comments.empty? %>
  <% file_ids = @patch.files.each_with_index.to_h { |f, i| [f.path, "f#{i}"] } %>
  <section class="comments" id="comments">
    <h2>Review comments (<%= comments.size %>)</h2>
    <% comments.each do |c| %>
      <% own = c.commit == sha %>
      <% id = own && file_ids[c.path] %>
      <%= erb :_comment, layout: false, locals: { c: c, href: id && "##{id}#{"-R#{c.start_line}-R#{c.end_line}" if c.line?}", removed: c.line? && !own, sha: sha } %>
    <% end %>
  </section>
<% end %>
