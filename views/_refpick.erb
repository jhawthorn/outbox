<%# Which branch, tag or commit the page is showing, and a menu of the %>
<%# others (filled in by assets/browse.js from refs.json). kind is the %>
<%# page the menu's links go to, at the same path. %>
<details class="refpick" data-refs-url="<%= repo_url(@repo) %>/refs.json" data-href="<%= rev_template(kind, @path) %>" data-current="<%= h @rev.name %>">
  <summary class="button" title="Switch branch or tag">
    <% if @rev.kind == :tag %><svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.752 1.752 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25ZM6 5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
    <% elsif @rev.commit? %><svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"/></svg>
    <% else %><svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"/></svg><% end %>
    <span class="name"><%= h rev_label(@rev) %></span><span class="caret" aria-hidden="true"></span>
  </summary>
  <div class="menu" role="dialog" aria-label="Switch branch or tag">
    <input type="search" class="filter" placeholder="Find a branch or tag" aria-label="Find a branch or tag" autocomplete="off" spellcheck="false">
    <ul class="refs" role="listbox"></ul>
    <a class="all" href="<%= repo_url(@repo) %>/branches">View all branches</a>
  </div>
</details>
