<div class="page-head">
  <h1>Repositories</h1>
  <% unless @repos.empty? %>
    <form class="inline" method="post" action="/fetch">
      <button type="submit" <%= "disabled" if @repos.all? { |_, _, status, _| status.busy? } %>>Fetch all upstreams</button>
    </form>
  <% end %>
</div>

<% @problems.each do |problem| %>
  <div class="panel danger"><span class="badge failed">config</span> <%= h problem %></div>
<% end %>

<% if @needs_token %>
  <div class="panel danger"><span class="badge failed">no token</span>
    <code>OUTBOX_UPSTREAM_TOKEN</code> is not set. Fetching and pushing https upstreams will fail until the server has one.</div>
<% end %>

<% pending_count = @repos.sum { |_, branches, _, _| branches.count(&:pending?) } %>
<p class="muted"><%= @repos.empty? ? "No repositories yet." : "#{pluralize(pending_count, "branch", "branches")} awaiting review across #{pluralize(@repos.size, "repository", "repositories")}." %></p>

<%# Repos that need a look get a card each: something to review, a job
    running, or one that failed. The rest are a plain list below. %>
<% cards, idle = @repos.partition { |_, branches, status, _| branches.any?(&:pending?) || status.busy? || (status.last && !status.last.ok?) } %>
<% unless cards.empty? %>
<ul class="repos">
<% cards.each do |repo, branches, status, pushed| %>
  <% pending = branches.select(&:pending?) %>
  <li class="repo <%= "pending" if pending.any? %>">
    <div class="repo-head">
      <a class="repo-name" href="<%= repo_url(repo) %>"><%= h repo.name %></a>
      <% if status.running? %>
        <span class="badge busy"><%= h job_label(status) %></span>
      <% elsif status.busy? %>
        <span class="badge busy">queued</span>
      <% elsif status.last && !status.last.ok? %>
        <span class="badge failed"><%= h status.last.job %> failed</span>
        <form class="inline" method="post" action="<%= repo_url(repo) %>/dismiss?back=/">
          <button type="submit">Dismiss</button>
        </form>
      <% end %>
      <span class="spacer"></span>
      <% if pushed %><span class="muted" title="<%= h pushed.utc.strftime("%Y-%m-%d %H:%M UTC") %>">pushed <%= time_ago(pushed) %></span><% end %>
    </div>
    <% if status.running? && status.progress %>
      <div class="progress muted"><%= h status.progress %></div>
    <% elsif !status.busy? && pending.any? %>
      <ul class="branches">
      <% pending.each do |b| %>
        <li>
          <span class="badge <%= b.status %>"><%= status_label(b.status) %></span>
          <a class="branch-name" href="<%= branch_url(repo, b.name) %>"><%= h b.name %></a>
          <span class="muted"><%= h summary(b) %></span>
        </li>
      <% end %>
      </ul>
    <% end %>
  </li>
<% end %>
</ul>
<% end %>

<% unless idle.empty? %>
<h2>Nothing to review</h2>
<ul class="repos idle">
<% idle.each do |repo, _, _, pushed| %>
  <li class="repo">
    <a class="repo-name" href="<%= repo_url(repo) %>"><%= h repo.name %></a>
    <% if repo.config? %><span class="muted">the outbox's own configuration</span><% end %>
    <span class="spacer"></span>
    <% if pushed %><span class="muted" title="<%= h pushed.utc.strftime("%Y-%m-%d %H:%M UTC") %>">pushed <%= time_ago(pushed) %></span><% end %>
  </li>
<% end %>
</ul>
<% end %>

<details class="add" <%= "open" if @repos.none? { |repo, _, _, _| !repo.config? } %>>
  <summary>Adding a repository</summary>
  <p class="muted">The list above comes from <code><%= h Outbox::Config::FILE %></code> in
  <code><%= h config_clone_url %></code>. Clone it, add a section, push to a branch, and
  approve the change here like any other.</p>
  <pre><code>[repo "myapp"]
    upstream = https://github.com/you/myapp.git</code></pre>
</details>
