<% @title = "Blame #{@path} at #{rev_label(@rev)} · #{@repo.name}" %>
<%= erb :_repo_head, layout: false, locals: { tab: "code" } %>
<div class="browse-bar">
  <%= erb :_refpick, layout: false, locals: { kind: "blame" } %>
  <h1 class="path"><%= path_crumbs(@repo, @rev.name, @path) %></h1>
  <span class="spacer"></span>
  <a class="button" href="<%= tree_url(@repo, @rev.name, @path) %>">View file</a>
  <a class="button" href="<%= history_url(@repo, @rev.name, @path) %>">History</a>
</div>
<% now = Time.now %>
<% oldest = @hunks.filter_map { |hk| commit_time(hk.commit.date) }.min || now %>
<div class="box blame" data-blame-file="<%= h @path %>">
  <table class="blame">
    <% @hunks.each do |hk| %>
      <% t = commit_time(hk.commit.date) || now %>
      <% age = oldest == now ? 0 : ((now - t) / (now - oldest) * 9).round.clamp(0, 9) %>
      <% hk.lines.each_with_index do |line, i| %>
        <% n = hk.start + i %>
        <tr id="L<%= n %>"<% if i.zero? %> class="hunk-start"<% end %>>
          <% if i.zero? %>
            <td class="who age<%= age %>" rowspan="<%= hk.lines.size %>">
              <div class="blame-commit">
                <span class="when muted" title="<%= h hk.commit.date %>"><%= t.strftime("%Y-%m-%d") %></span>
                <a class="subject" href="<%= show_commit_url(@repo, hk.commit.sha) %>" title="<%= h hk.commit.subject %> — <%= h hk.commit.author %>"><%= hv hk.commit.subject %></a>
                <span class="who-name" title="<%= h hk.commit.author %>"><%= hv hk.commit.author.split.first %></span>
                <% if hk.previous %><a class="reblame" href="<%= blame_url(@repo, hk.previous[0], hk.previous[1]) %>" title="Blame prior to this change" aria-label="Blame prior to this change"><svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M1.705 8.005a.75.75 0 0 1 .834.656 5.5 5.5 0 0 0 9.592 2.97l-1.204-1.204a.25.25 0 0 1 .177-.427h3.646a.25.25 0 0 1 .25.25v3.646a.25.25 0 0 1-.427.177l-1.38-1.38A7.002 7.002 0 0 1 1.05 8.84a.75.75 0 0 1 .656-.834ZM8 2.5a5.487 5.487 0 0 0-4.131 1.869l1.204 1.204A.25.25 0 0 1 4.896 6H1.25A.25.25 0 0 1 1 5.75V2.104a.25.25 0 0 1 .427-.177l1.38 1.38A7.002 7.002 0 0 1 14.95 7.16a.75.75 0 0 1-1.49.178A5.5 5.5 0 0 0 8 2.5Z"/></svg></a><% end %>
              </div>
            </td>
          <% end %>
          <td class="num"><a href="#L<%= n %>"><%= n %></a></td>
          <td class="code"><%= h line %></td>
        </tr>
      <% end %>
    <% end %>
  </table>
</div>
