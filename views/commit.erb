<% @title = "#{@commit.short} · #{@repo.name} / #{@branch.name}" %>
<%= erb :_repo_head, layout: false, locals: { tab: "review" } %>
<div class="commit-nav">
  <span class="muted"><a href="<%= review_url(@repo) %>">Review</a> / <a href="<%= branch_url(@repo, @branch.name) %>"><%= h @branch.name %></a> / commit <%= @position %> of <%= @total %></span>
  <span class="spacer"></span>
  <nav class="actions">
    <% if @older %>
      <a class="button" href="<%= commit_url(@repo, @branch.name, @older) %>" title="<%= h @older.subject %>">← older: <%= h @older.subject %></a>
    <% else %>
      <span class="button disabled">← oldest</span>
    <% end %>
    <% if @newer %>
      <a class="button" href="<%= commit_url(@repo, @branch.name, @newer) %>" title="<%= h @newer.subject %>">newer: <%= h @newer.subject %> →</a>
    <% else %>
      <span class="button disabled">newest →</span>
    <% end %>
  </nav>
</div>
<%= erb :_commit_head, layout: false, locals: { c: @commit } %>
<%= erb :_commit_comments, layout: false, locals: { comments: @comments, sha: @commit.sha } %>
<%= render_patch(@patch, commit_patch_url(@repo, @branch.name, @commit.sha), @commit.sha) %>
