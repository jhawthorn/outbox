<%# The top of every page in a repository: its name, code search, and the %>
<%# tabs. tab is the one this page is under; actions, HTML for the right. %>
<div class="repo-bar">
  <div class="repo-title"><a href="<%= repo_url(@repo) %>"><%= h @repo.name %></a></div>
  <span class="spacer"></span>
  <form class="code-search" action="<%= search_url(@repo) %>" role="search">
    <input type="search" name="q" value="<%= h @query %>" placeholder="Search code" aria-label="Search code" autocomplete="off" spellcheck="false" data-hotkey="/">
    <% if @rev && !@rev.commit? %><input type="hidden" name="rev" value="<%= h @rev.name %>"><% elsif @rev %><input type="hidden" name="rev" value="<%= @rev.sha %>"><% end %>
    <kbd class="hint">/</kbd>
  </form>
  <%= actions if defined?(actions) && actions %>
</div>
<nav class="tabs"><%= repo_tabs(tab) %></nav>
