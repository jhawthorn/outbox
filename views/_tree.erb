<%# A directory as it is in @rev: what is in it, and the last commit to %>
<%# touch it and each entry. %>
<%= erb :_pending_note, layout: false %>
<div class="browse-bar">
  <%= erb :_refpick, layout: false, locals: { kind: "tree" } %>
  <% unless @path.empty? %><h2 class="path"><%= path_crumbs(@repo, @rev.name, @path) %></h2><% end %>
  <span class="spacer"></span>
  <% default = @repo.default_rev&.name %>
  <% if default && !@rev.commit? && @rev.name != default %><a class="button" href="<%= compare_url(@repo, default, @rev.name) %>" title="What <%= h @rev.name %> has that <%= h default %> does not">Compare with <%= h default %></a><% end %>
  <button type="button" class="button" data-finder="<%= repo_url(@repo) %>/files/<%= @sha %>" data-tree-base="<%= tree_url(@repo, @rev.name) %>" title="Find a file by name (t)">Go to file</button>
  <% if @path.empty? %>
    <details class="clone">
      <summary class="button primary">Clone</summary>
      <div class="menu">
        <label>Clone over HTTP</label>
        <div class="copy-row"><input type="text" readonly value="<%= h clone_url(@repo) %>" aria-label="Clone URL"><button type="button" class="button" data-copy="<%= h clone_url(@repo) %>">Copy</button></div>
      </div>
    </details>
  <% end %>
</div>
<div class="box">
  <%= erb :_last_commit, layout: false, locals: { hotkey: true } %>
  <table class="tree" data-commits-url="<%= repo_url(@repo) %>/tree-commits/<%= @sha %><%= "/#{url_path(@path)}" unless @path.empty? %>" data-commit-base="<%= repo_url(@repo) %>/commit/">
    <% unless @path.empty? %>
      <tr><td class="icon"></td><td class="name" colspan="4"><a href="<%= tree_url(@repo, @rev.name, File.dirname(@path).sub(/\A\.\z/, "")) %>" title="Up one directory">..</a></td></tr>
    <% end %>
    <% @entries.each do |e| %>
      <% full = [@path, e.name].reject(&:empty?).join("/") %>
      <tr data-entry="<%= h e.name %>">
        <td class="icon" title="<%= e.dir? ? "directory" : e.submodule? ? "submodule" : e.symlink? ? "symbolic link" : "file" %>"><%= erb :_entry_icon, layout: false, locals: { e: e } %></td>
        <td class="name">
          <% if e.submodule? %>
            <span><%= hv e.name %></span> <span class="muted">@ <code><%= e.id[0, 7] %></code></span>
          <% else %>
            <a href="<%= tree_url(@repo, @rev.name, full) %>"><%= hv e.name %></a>
          <% end %>
        </td>
        <td class="msg"></td>
        <td class="when muted"></td>
        <td class="size muted"><%= byte_size(e.size) if e.size %></td>
      </tr>
    <% end %>
    <% if @entries.empty? %><tr><td colspan="5" class="muted">Empty directory.</td></tr><% end %>
  </table>
</div>
