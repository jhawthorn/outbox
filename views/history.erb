<% @title = "History of #{@path.empty? ? rev_label(@rev) : @path} · #{@repo.name}" %>
<%= erb :_repo_head, layout: false, locals: { tab: "commits" } %>
<div class="browse-bar">
  <%= erb :_refpick, layout: false, locals: { kind: "commits" } %>
  <h2 class="path"><% if @path.empty? %>Commits<% else %>History of <%= path_crumbs(@repo, @rev.name, @path, kind: "commits") %><% end %></h2>
  <span class="spacer"></span>
  <a class="button" href="<%= tree_url(@repo, @rev.name, @path) %>">Browse <%= @path.empty? ? "files" : "this" %></a>
</div>

<% if @commits.empty? %>
  <p class="empty">No commits.</p>
<% end %>
<% unless @commits.empty? %>
  <div class="box log">
    <% @commits.each do |c| %>
      <div class="log-row">
        <div class="main">
          <a class="subject" href="<%= show_commit_url(@repo, c.sha) %>"><%= hv c.subject %></a>
          <% if c.merge? %><span class="badge merge">merge</span><% end %>
          <% if c.body? %>
            <details class="more">
              <summary class="ellipsis" title="Show full commit message">…</summary>
              <pre class="message"><%= hv c.body %></pre>
            </details>
          <% end %>
          <div class="muted meta"><b><%= hv c.author %></b><% if c.committer_differs? %>, committed by <%= hv c.committer %><% end %> · <%= when_label(c.commit_date) %></div>
        </div>
        <div class="row-actions">
          <a class="sha" href="<%= show_commit_url(@repo, c.sha) %>"><code><%= c.short[0, 7] %></code></a>
          <button type="button" class="button icon-only" data-copy="<%= c.sha %>" title="Copy the full sha" aria-label="Copy the full sha"><svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path fill="currentColor" d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg></button>
          <a class="button icon-only" href="<%= tree_url(@repo, c.sha, @path) %>" title="Browse the files at this commit" aria-label="Browse the files at this commit"><svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Zm-6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Z"/></svg></a>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<nav class="pager">
  <% if @page > 1 %><a class="button" href="?page=<%= @page - 1 %>" rel="prev">Newer</a><% else %><span class="button disabled">Newer</span><% end %>
  <% if @more %><a class="button" href="?page=<%= @page + 1 %>" rel="next">Older</a><% else %><span class="button disabled">Older</span><% end %>
</nav>
