<% @title = "#{@commit.subject} · #{@commit.short[0, 7]} · #{@repo.name}" %>
<%= erb :_repo_head, layout: false, locals: { tab: "commits" } %>
<div class="box commit-head">
  <div class="pad">
    <h1 class="commit-title"><%= hv @commit.subject %></h1>
    <% if @commit.body? %><pre class="message"><%= hv @commit.body %></pre><% end %>
  </div>
  <div class="commit-meta">
    <span><%= identity_line(@commit) %></span>
    <span class="spacer"></span>
    <span class="muted">
      <% if @commit.root? %>root commit<% else %><%= @commit.parents.size == 1 ? "parent" : "parents" %>
        <% @commit.parents.each do |p| %><a href="<%= show_commit_url(@repo, p) %>"><code><%= p[0, 7] %></code></a><% end %><% end %>
      · commit <code><%= @commit.sha %></code>
      <button type="button" class="button icon-only" data-copy="<%= @commit.sha %>" title="Copy the full sha" aria-label="Copy the full sha"><svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path fill="currentColor" d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg></button>
    </span>
    <a class="button" href="<%= tree_url(@repo, @commit.sha) %>">Browse files</a>
  </div>
</div>
<% if @commit.merge? %><p class="muted">A merge: shown against its first parent, <code><%= @commit.parents.first[0, 7] %></code>.</p><% end %>
<%= render_patch(@patch, "#{show_commit_url(@repo, @commit.sha)}.patch", @commit.sha) %>
