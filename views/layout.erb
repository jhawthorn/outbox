<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= @title ? "#{h @title} · outbox" : "outbox" %></title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Cstyle%3E.t%7Bfill:%231b1f23%7D@media(prefers-color-scheme:dark)%7B.t%7Bfill:%23c9d1d9%7D%7D%3C/style%3E%3Cpath fill=%27%2322863a%27 d=%27M3 7h4V3h4v4h4v4h-4v4H7v-4H3z%27/%3E%3Cpath fill=%27%23cb2431%27 d=%27M18 7h11v4H18z%27/%3E%3Cpath class=%27t%27 fill-rule=%27evenodd%27 d=%27M2 18h7v3h14v-3h7v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3zm3 3v7h22v-4h-1a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3H5z%27/%3E%3C/svg%3E">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)">
<%# Basic auth: the manifest is fetched without credentials unless asked to. %>
<link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">
<link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png">
<script>if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js");</script>
<style>
  :root {
    --bg: #ffffff; --fg: #1b1f23; --muted: #6a737d; --line: #e1e4e8;
    --accent: #0366d6; --ok: #22863a; --warn: #b08800; --bad: #cb2431;
    --add-bg: #e6ffed; --del-bg: #ffeef0; --hunk-bg: #f1f8ff; --meta-bg: #fafbfc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --fg: #c9d1d9; --muted: #8b949e; --line: #30363d;
      --accent: #58a6ff; --ok: #3fb950; --warn: #d29922; --bad: #f85149;
      --add-bg: #12261e; --del-bg: #2d1316; --hunk-bg: #161b22; --meta-bg: #161b22;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  header { border-bottom: 1px solid var(--line); padding: 0 16px; }
  header .in { max-width: 1100px; margin: 0 auto; display: flex; gap: 16px; align-items: center; height: 48px; }
  header a.brand { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--fg); text-decoration: none; }
  header a.brand span { color: var(--muted); font-weight: 400; }
  header .keys-help { border: 0; background: none; padding: 0; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
  a { color: var(--accent); }
  h1 { font-size: 22px; margin: 0 0 16px; }
  /* Title row: the heading, then whatever acts on the whole page. */
  .page-head { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin: 0 0 16px; }
  .page-head h1 { margin: 0; flex: 1; min-width: 0; }
  h1 .crumb { color: var(--muted); font-weight: 400; text-decoration: none; }
  h1 .crumb:hover { text-decoration: underline; }
  h1 .sep { color: var(--muted); font-weight: 400; margin: 0 8px; }
  h2 { font-size: 17px; margin: 32px 0 8px; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  code { background: var(--meta-bg); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  ul.repos, ul.branches { list-style: none; margin: 0; padding: 0; }
  li.repo { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 0 0 10px; }
  li.repo.pending { border-left: 4px solid var(--accent); }
  .repo-head { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .repo-head .spacer { flex: 1; }
  /* Repos with nothing to review: a plain list, not a card each. */
  ul.repos.idle li.repo { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap;
                          border: 0; border-bottom: 1px solid var(--line); border-radius: 0; padding: 8px 0; margin: 0; }
  ul.repos.idle li.repo:last-child { border-bottom: 0; }
  ul.repos.idle .spacer { flex: 1; }
  ul.repos.idle .repo-name { font-size: 15px; }
  .repo-name { font-size: 16px; font-weight: 600; }
  /* One grid for the whole list, so the badges, names and summaries line
     up down the card however wide each badge is. */
  ul.branches { display: grid; grid-template-columns: max-content max-content minmax(0, 1fr);
                gap: 5px 12px; align-items: baseline; margin-top: 10px; }
  ul.branches li { display: contents; }
  ul.branches .badge { justify-self: start; }
  .branch-name { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  .muted { color: var(--muted); }
  .badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px;
           border: 1px solid currentColor; white-space: nowrap; }
  .badge.synced   { color: var(--muted); }
  .badge.ready    { color: var(--ok); }
  .badge.new      { color: var(--accent); }
  .badge.deleted  { color: var(--bad); }
  .badge.diverged { color: var(--warn); }
  .badge.busy     { color: var(--accent); }
  .badge.failed   { color: var(--bad); }
  .progress { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; margin-top: 6px; }
  form.inline { display: inline; }
  button { font: inherit; font-size: 13px; padding: 4px 10px; border-radius: 6px; cursor: pointer;
           border: 1px solid var(--line); background: var(--meta-bg); color: var(--fg); }
  button.primary { background: var(--ok); border-color: var(--ok); color: #fff; }
  button.danger  { color: var(--bad); }
  button.warn    { background: var(--warn); border-color: var(--warn); color: #fff; }
  button:disabled { opacity: .5; cursor: default; }
  input[type=text], input[type=url] { font: inherit; padding: 5px 8px; border: 1px solid var(--line);
           border-radius: 6px; background: var(--bg); color: var(--fg); min-width: 240px; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  .toolbar .spacer { flex: 1; }
  .panel { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
  .panel.warn { border-color: var(--warn); }
  .panel.danger { border-color: var(--bad); }
  /* A branch's standing against upstream, with what can be done about it.
     The stripe takes the status colour, like the badge in the title. */
  .review { display: flex; gap: 16px 24px; align-items: center; justify-content: space-between; flex-wrap: wrap;
            margin: 0 0 8px; border-left: 4px solid var(--muted); }
  .review.ready    { border-left-color: var(--ok); }
  .review.new      { border-left-color: var(--accent); }
  .review.deleted  { border-left-color: var(--bad); }
  .review.diverged { border-left-color: var(--warn); }
  .review .state { min-width: 0; }
  .review .summary { font-weight: 600; }
  .review .summary::first-letter { text-transform: uppercase; }
  .review .detail { font-size: 13px; margin-top: 2px; }
  .review .note { font-size: 13px; color: var(--warn); margin-top: 2px; }
  .review .note.drops { color: var(--bad); font-weight: 600; }
  .patch-summary { border: 1px solid var(--line); border-radius: 8px; padding: 10px 16px; margin: 0 0 16px; }
  .patch-summary details.file-list > summary { cursor: pointer; color: var(--accent); font-size: 14px; margin-top: 4px; }
  .patch-summary details.file-list[open] > summary { color: var(--muted); }
  .patch-summary ul { list-style: none; margin: 6px 0 0; padding: 0; display: grid;
                      grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 2px 16px; align-items: baseline; }
  .patch-summary li { display: contents; }
  .patch-summary li .path { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .patch-summary li .counts { text-align: right; white-space: nowrap; }
  .patch-summary li .view { font-size: 13px; white-space: nowrap; }
  /* The diff's files as a tree, beside the diff (diffs.js). */
  body.codeview.with-tree { display: grid; grid-template-columns: 300px minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); }
  body.codeview.with-tree > header { grid-column: 1 / -1; }
  body.codeview.with-tree > main.codeview { padding: 0 max(16px, calc((100% - 1068px) / 2)); }
  aside.filetree { display: none; }
  body.codeview.with-tree > aside.filetree { display: flex; flex-direction: column; min-height: 0; border-right: 1px solid var(--line);
                                              background: var(--meta-bg); font-size: 13px; }
  aside.filetree .tree-head { padding: 12px 12px 8px; display: flex; flex-direction: column; gap: 6px; }
  aside.filetree .tree-head input { font: inherit; padding: 4px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }
  aside.filetree .progress-line { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 12px; }
  aside.filetree .progress-line .meter { flex: 1; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
  aside.filetree .progress-line .meter i { display: block; height: 100%; background: var(--ok); }
  aside.filetree ul { list-style: none; margin: 0; padding: 0; }
  aside.filetree > ul { overflow-y: auto; padding: 0 6px 24px; flex: 1; }
  aside.filetree li > a, aside.filetree li > .dir { display: flex; gap: 6px; align-items: center; padding: 2px 6px; border-radius: 6px;
                                                      color: var(--fg); text-decoration: none; white-space: nowrap; cursor: pointer; }
  aside.filetree li > a:hover, aside.filetree li > .dir:hover { background: var(--line); }
  aside.filetree li > a[aria-current="true"] { background: color-mix(in srgb, var(--accent) 15%, transparent); font-weight: 600; }
  aside.filetree li > a .n, aside.filetree li > .dir .n { overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
  aside.filetree .dir { color: var(--muted) !important; }
  aside.filetree .dir::before { content: ""; width: 5px; height: 5px; border: solid currentColor; border-width: 0 1.5px 1.5px 0;
                                transform: rotate(45deg); margin: 0 3px 3px 1px; flex: none; transition: transform .1s; }
  aside.filetree li.closed > .dir::before { transform: rotate(-45deg); margin: 0 3px 0 0; }
  aside.filetree li.closed > ul { display: none; }
  aside.filetree ul ul { padding-left: 12px; }
  aside.filetree .st { width: 8px; height: 8px; border-radius: 2px; flex: none; background: var(--accent); }
  aside.filetree .st.added { background: var(--ok); }
  aside.filetree .st.deleted { background: var(--bad); }
  aside.filetree .st.renamed, aside.filetree .st.copied { background: var(--warn); }
  aside.filetree a.viewed .n { color: var(--muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--muted) 50%, transparent); }
  aside.filetree a .check { color: var(--ok); font-size: 12px; }
  label.viewed { display: inline-flex; gap: 4px; align-items: center; padding: 1px 8px; border: 1px solid var(--line); border-radius: 6px;
                 font: 12px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--muted); cursor: pointer; user-select: none; }
  label.viewed:has(input:checked) { color: var(--ok); border-color: var(--ok); background: color-mix(in srgb, var(--ok) 10%, transparent); }
  label.viewed input { margin: 0; }
  @media (max-width: 1000px) { body.codeview.with-tree { grid-template-columns: minmax(0, 1fr); }
                               body.codeview.with-tree > aside.filetree { display: none; } }
  .count { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; }
  .count.add { color: var(--ok); }
  .count.del { color: var(--bad); }
  .badge.added   { color: var(--ok); }
  .badge.deleted { color: var(--bad); }
  .badge.renamed, .badge.copied { color: var(--accent); }
  details.file { border: 1px solid var(--line); border-radius: 8px; margin: 0 0 12px; }
  details.file > summary { cursor: pointer; padding: 8px 12px; background: var(--meta-bg);
                           display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  details.file > summary { position: sticky; top: 0; z-index: 2; }
  details.file { overflow: clip; }
  .diff-controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 0 0 12px; }
  .diff-controls .seg { display: inline-flex; }
  .diff-controls .seg button:first-child { border-radius: 6px 0 0 6px; }
  .diff-controls .seg button:last-child { border-radius: 0 6px 6px 0; margin-left: -1px; }
  .diff-controls button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  details.file > summary code { border: 0; background: none; padding: 0; font-weight: 600; }
  .badge.hidden { color: #fff; background: var(--bad); border-color: var(--bad); }
  /* Diff bodies are drawn by the browser bundle; until it runs, or if it
     cannot, the placeholder shows its text. */
  details.file .diff { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; }
  details.file .diff:empty { min-height: 40px; }
  details.file .diff > noscript, details.file .diff > a { padding: 8px 12px; font: 14px/1.5 system-ui, sans-serif; }
  /* Once diffs.js mounts its CodeView, <main> is the page's scroller, under
     the site header, and its content keeps the usual column. */
  body.codeview { height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
  body.codeview > header { flex: none; }
  main.codeview { flex: 1; min-height: 0; max-width: none; margin: 0; overflow-y: auto; outline: none;
                  padding: 0 max(16px, calc((100% - 1068px) / 2)); }
  .codeview-head { padding-top: 24px; }
  .codeview-foot { padding: 8px 0; color: var(--muted); font-size: 13px; }
  main.codeview diffs-container { border: 1px solid var(--line); border-radius: 8px; overflow: clip; }
  /* In the slots of pierre's file headers. */
  button.fold { border: 0; background: none; padding: 0; margin-right: 4px; width: 18px; height: 18px; color: var(--muted);
                display: inline-flex; align-items: center; justify-content: center; }
  button.fold::before { content: ""; width: 6px; height: 6px; border: solid currentColor; border-width: 0 1.5px 1.5px 0;
                        transform: translateY(-2px) rotate(45deg); transition: transform .1s; }
  button.fold[aria-expanded="false"]::before { transform: translateX(-2px) rotate(-45deg); }
  button.fold:hover { color: var(--fg); }
  .file-actions { display: inline-flex; gap: 8px; align-items: center; margin-left: 8px; }
  .file-actions .file-notes { margin: 0; }
  button.whole { font: 12px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; padding: 1px 8px; color: var(--muted); }
  button.whole:hover { color: var(--fg); }
  button.whole[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); }
  .file-notes { display: inline-flex; gap: 8px; align-items: center; margin: 0 8px;
                font: 12px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  pre.message { background: var(--meta-bg); border: 1px solid var(--line); border-radius: 8px;
                padding: 12px 16px; white-space: pre-wrap; margin: 0 0 16px; }
  details.more { display: inline; }
  details.more > summary.ellipsis { display: inline-block; cursor: pointer; list-style: none; user-select: none;
                                    font-size: 12px; line-height: 1; padding: 1px 8px 4px; margin-left: 6px;
                                    border-radius: 6px; background: var(--line); color: var(--muted); vertical-align: middle; }
  details.more > summary.ellipsis::-webkit-details-marker { display: none; }
  details.more > summary.ellipsis:hover, details.more[open] > summary.ellipsis { background: var(--accent); color: #fff; }
  details.more > pre.message { margin: 8px 0 4px 0; font-size: 12.5px; color: var(--muted); }
  /* The commit list on a branch: oldest at the bottom, resting on the commit
     it builds on, so which way is back in time never needs saying. */
  .history { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .history .commit { display: grid; grid-template-columns: 24px minmax(0, 1fr) 120px; column-gap: 12px;
                     padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .history .commit:last-child { border-bottom: 0; }
  .history .rail { grid-row: 1 / span 2; position: relative; }
  .history .rail::before { content: ""; position: absolute; left: 11px; top: -11px; bottom: -11px; width: 2px; background: var(--accent); }
  .history .commit:first-child .rail::before { top: 12px; }
  .history .rail::after { content: ""; position: absolute; left: 5px; top: 6px; width: 14px; height: 14px; box-sizing: border-box;
                          border: 2px solid var(--accent); border-radius: 50%; background: var(--bg); }
  .history .title { grid-column: 2; min-width: 0; }
  .history .meta { grid-column: 2; min-height: 36px; font-size: 12.5px; line-height: 18px; color: var(--muted); }
  .history .line { display: grid; grid-template-columns: 92px minmax(0, 380px) auto; white-space: nowrap; }
  .history .name { overflow: hidden; text-overflow: ellipsis; padding-right: 14px; }
  .history .name i { font-style: italic; }
  .history .committer { color: var(--warn); }
  .history .hash { background: none; border: 0; padding: 0; color: var(--muted); font-size: 12.5px; }
  .history .when { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; }
  .history .off { opacity: .55; }
  .history .size { grid-column: 3; grid-row: 1 / span 2; align-self: center; font-size: 12px; }
  .history .bar { display: flex; height: 6px; margin-bottom: 3px; border-radius: 3px; overflow: hidden; background: var(--line); }
  .history .bar i { display: block; height: 100%; }
  .history .bar .before { background: var(--muted); opacity: .45; }
  .history .bar .share { background: var(--accent); }
  .history .commit.base { background: color-mix(in srgb, var(--ok) 10%, var(--bg)); }
  .history .commit.base .title { font-weight: 600; }
  .history .commit.base .meta { min-height: 0; }
  .history .commit.base .rail::before, .history .commit.stub .rail::before { background: var(--ok); width: 6px; left: 9px; }
  .history .commit.base .rail::after { border-color: var(--ok); background: var(--ok); border-radius: 3px; left: 5px; }
  .history .commit.stub { background: color-mix(in srgb, var(--ok) 6%, var(--bg)); padding-top: 6px; padding-bottom: 6px; }
  .history .commit.stub .rail::after { display: none; }
  .history .commit.stub .rail::before { bottom: 0; }
  .history .commit.stub b { color: var(--ok); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  /* Commits upstream has that approving removes: the same rows, in red. */
  .history.dropped { border-color: var(--bad); }
  .history.dropped .rail::before { background: var(--bad); }
  .history.dropped .rail::after { border-color: var(--bad); }
  .history.dropped .bar .share { background: var(--bad); }
  .invis { background: var(--bad); color: #fff; font-size: 10px; font-weight: 700; padding: 0 4px;
           border-radius: 3px; margin: 0 1px; vertical-align: middle; }
  .badge.merge { color: var(--warn); margin-left: 6px; }
  .badge.same { color: var(--muted); margin-left: 6px; font-weight: 400; }
  .badge.changed { color: var(--warn); margin-left: 6px; }
  .badge.tip { color: var(--accent); margin-left: 6px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 400; text-decoration: none; }
  .commit .subject { font-weight: 600; color: var(--fg); text-decoration: none; }
  .commit .subject:hover { text-decoration: underline; }
  .empty { color: var(--muted); padding: 24px 0; }
  /* A file or directory in a commit: the path as breadcrumbs, then what it
     is and where it came from. */
  h1.path { font-size: 20px; overflow-wrap: anywhere; }
  h1.path b { font-weight: 600; }
  h1.path code { font-size: 15px; }
  .path-meta { margin: -8px 0 16px; font-size: 13px; }
  /* --- Browsing: a repository's header and tabs, the code, history. --- */
  .icon { vertical-align: text-bottom; flex: none; }
  .spacer { flex: 1; }
  kbd { font: 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; padding: 1px 5px; border: 1px solid var(--line);
        border-bottom-width: 2px; border-radius: 4px; color: var(--muted); background: var(--meta-bg); }
  .repo-bar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: -8px 0 0; }
  .repo-title { display: flex; gap: 8px; align-items: center; font-size: 20px; font-weight: 600; }
  .repo-title .icon { color: var(--muted); }
  .repo-title a { color: var(--fg); text-decoration: none; }
  .repo-title a:hover { color: var(--accent); }
  .code-search { position: relative; display: flex; align-items: center; }
  .code-search input { font: inherit; font-size: 13px; padding: 4px 30px 4px 10px; width: 260px; border: 1px solid var(--line);
                       border-radius: 6px; background: var(--meta-bg); color: var(--fg); }
  .code-search input:focus { outline: 2px solid var(--accent); outline-offset: -1px; background: var(--bg); width: 340px; }
  .code-search .hint { position: absolute; right: 8px; pointer-events: none; }
  .code-search input:focus + .hint, .code-search input:focus ~ .hint { display: none; }
  nav.tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin: 10px 0 20px; overflow-x: auto; }
  nav.tabs a.tab { padding: 8px 12px; color: var(--fg); text-decoration: none; font-size: 14px; border-bottom: 2px solid transparent;
                   margin-bottom: -1px; white-space: nowrap; border-radius: 6px 6px 0 0; }
  nav.tabs a.tab:hover { background: var(--meta-bg); }
  nav.tabs a.tab.active { border-bottom-color: #fd8c73; font-weight: 600; }
  .count-pill { display: inline-block; min-width: 20px; padding: 0 6px; margin-left: 4px; border-radius: 999px; font-size: 12px;
                font-weight: 500; line-height: 18px; text-align: center; background: var(--line); }
  .remotes { display: flex; gap: 6px 16px; flex-wrap: wrap; font-size: 13px; margin: -8px 0 16px; }
  .remotes code { font-size: 12px; }
  .empty.compact { padding: 4px 0; }
  .browse-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 0 0 12px; min-height: 32px; }
  .browse-bar h1.path, .browse-bar h2.path { margin: 0 0 0 4px; font-size: 16px; font-weight: 400; min-width: 0; overflow-wrap: anywhere; }
  .browse-bar .path b { font-weight: 600; }
  .browse-bar .path .crumb { color: var(--accent); text-decoration: none; font-weight: 400; }
  .browse-bar .path .crumb:hover { text-decoration: underline; }
  .browse-bar .path .sep { color: var(--muted); margin: 0 4px; }
  a.button, .button, summary.button { display: inline-flex; gap: 6px; align-items: center; font: inherit; font-size: 13px; line-height: 20px;
             padding: 4px 10px; border-radius: 6px; border: 1px solid var(--line); background: var(--meta-bg); color: var(--fg);
             text-decoration: none; white-space: nowrap; cursor: pointer; }
  a.button:hover, .button:hover, summary.button:hover { border-color: var(--muted); }
  .button.primary, summary.button.primary { background: var(--ok); border-color: var(--ok); color: #fff; }
  .button.icon-only { padding: 4px 7px; color: var(--muted); }
  .button.disabled { opacity: .5; cursor: default; pointer-events: none; }
  .button.active { background: var(--bg); font-weight: 600; }
  .seg { display: inline-flex; }
  .seg .button { border-radius: 0; }
  .seg .button:first-child { border-radius: 6px 0 0 6px; }
  .seg .button:last-child { border-radius: 0 6px 6px 0; margin-left: -1px; }
  summary.button { list-style: none; }
  summary.button::-webkit-details-marker { display: none; }
  .caret { width: 0; height: 0; border: 4px solid transparent; border-top-color: currentColor; margin-top: 4px; }
  /* Menus that drop from a button: the ref picker, clone. */
  details.refpick, details.clone { position: relative; }
  details.refpick .name { max-width: 220px; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  details > .menu { position: absolute; z-index: 20; top: calc(100% + 4px); left: 0; width: 320px; background: var(--bg);
                    border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 8px 24px rgb(0 0 0 / .18); padding: 8px; }
  details.clone > .menu { left: auto; right: 0; width: 380px; }
  .menu label { display: block; font-weight: 600; font-size: 13px; margin: 0 0 6px; }
  .copy-row { display: flex; gap: 6px; }
  .copy-row input { flex: 1; min-width: 0; font: 12px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; padding: 4px 8px;
                    border: 1px solid var(--line); border-radius: 6px; background: var(--meta-bg); color: var(--fg); }
  .menu input.filter { width: 100%; font: inherit; font-size: 13px; padding: 5px 8px; border: 1px solid var(--line); border-radius: 6px;
                       background: var(--bg); color: var(--fg); margin: 0 0 6px; }
  .menu ul.refs { list-style: none; margin: 0; padding: 0; max-height: 320px; overflow-y: auto; }
  .menu ul.refs li a { display: flex; gap: 8px; align-items: baseline; padding: 4px 8px; border-radius: 6px; color: var(--fg);
                       text-decoration: none; font-size: 13px; }
  .menu ul.refs li a .ref { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .menu ul.refs li a[aria-selected="true"], .menu ul.refs li a:hover { background: var(--hunk-bg); }
  .menu ul.refs li a.current { font-weight: 600; }
  .menu ul.refs li.group { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 6px 8px 2px; }
  .menu a.all { display: block; border-top: 1px solid var(--line); margin-top: 6px; padding: 6px 8px 0; font-size: 13px; }
  .box { border: 1px solid var(--line); border-radius: 8px; margin: 0 0 16px; overflow: hidden; }
  .box-head { display: flex; gap: 8px; align-items: center; padding: 8px 16px; background: var(--meta-bg); border-bottom: 1px solid var(--line);
              font-size: 14px; font-weight: 600; }
  .box-head a { color: var(--fg); text-decoration: none; }
  .box-head a:hover { color: var(--accent); text-decoration: underline; }
  .pad { padding: 12px 16px; }
  .last-commit { display: flex; gap: 10px; align-items: center; padding: 10px 16px; background: var(--meta-bg); font-size: 13px; min-width: 0; }
  .last-commit .who { font-weight: 600; white-space: nowrap; }
  .last-commit .subject { color: var(--muted); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .last-commit .subject:hover { color: var(--accent); text-decoration: underline; }
  .last-commit .sha { text-decoration: none; }
  .last-commit .sha code { background: none; border: 0; padding: 0; color: var(--muted); font-size: 12px; }
  .last-commit .when { white-space: nowrap; }
  .last-commit .history-link { display: inline-flex; gap: 4px; align-items: center; color: var(--fg); text-decoration: none; font-weight: 600; white-space: nowrap; }
  .last-commit .history-link:hover { color: var(--accent); }
  table.tree { border-top: 1px solid var(--line); }
  .file-box .file-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding: 8px 16px; border-top: 1px solid var(--line); font-size: 13px; }
  .file-box { margin-bottom: 12px; }
  table.tree tr:last-child td { border-bottom: 0; }
  table.tree tr:hover td { background: var(--meta-bg); }
  table.tree td { padding: 6px 16px; font-size: 14px; }
  table.tree td.icon { width: 1%; color: var(--muted); padding-right: 0; line-height: 0; vertical-align: middle; }
  table.tree td.icon .dir { color: #54aeff; }
  table.tree td.size { width: 1%; white-space: nowrap; text-align: right; font-size: 13px; }
  table.tree td.name { width: 30%; white-space: nowrap; }
  table.tree td.msg { max-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
  table.tree td.msg a { color: var(--muted); }
  table.tree td.msg a:hover { color: var(--accent); }
  table.tree td.when { width: 1%; white-space: nowrap; text-align: right; font-size: 13px; }
  @media (max-width: 700px) { table.tree td.msg, table.tree td.when { display: none; } }
  table.tree a { text-decoration: none; color: var(--fg); }
  table.tree a:hover { text-decoration: underline; color: var(--accent); }
  .pending-note { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 8px 14px; margin: 0 0 12px; font-size: 14px;
                  border: 1px solid var(--accent); border-radius: 8px; background: color-mix(in srgb, var(--accent) 7%, var(--bg)); }
  .image-view { padding: 24px; text-align: center;
                background: repeating-conic-gradient(var(--meta-bg) 0 25%, var(--bg) 0 50%) 0 0 / 20px 20px; }
  .image-view img { max-width: 100%; }
  pre.plain-readme { margin: 0; padding: 16px; white-space: pre-wrap; }
  /* History: a day at a time. */
  h3.day { font-size: 14px; font-weight: 400; color: var(--muted); margin: 20px 0 8px; display: flex; gap: 8px; align-items: center; }
  h3.day::before { content: ""; width: 8px; height: 8px; border-radius: 50%; border: 2px solid var(--muted); }
  .log-row { display: flex; gap: 16px; align-items: center; padding: 8px 16px; border-bottom: 1px solid var(--line); }
  .log-row:last-child { border-bottom: 0; }
  .log-row:hover { background: var(--meta-bg); }
  .log-row .main { flex: 1; min-width: 0; }
  .log-row .subject { font-weight: 600; color: var(--fg); text-decoration: none; }
  .log-row .subject:hover { color: var(--accent); text-decoration: underline; }
  .log-row .meta { font-size: 12px; margin-top: 2px; }
  .log-row .row-actions { display: flex; gap: 6px; align-items: center; }
  .log-row .sha code, .commit-meta code { font-size: 12px; }
  .log-row .sha { text-decoration: none; }
  nav.pager { display: flex; gap: 8px; justify-content: center; margin: 24px 0; }
  /* One commit. */
  .commit-head h1.commit-title { font-size: 20px; margin: 0; overflow-wrap: anywhere; }
  .commit-head pre.message { margin: 10px 0 0; border: 0; padding: 0; background: none; }
  .commit-meta { display: flex; gap: 8px 12px; align-items: center; flex-wrap: wrap; padding: 8px 16px; border-top: 1px solid var(--line);
                 background: var(--meta-bg); font-size: 13px; }
  .commit-meta code { background: none; border: 0; padding: 0; }
  /* Branches. */
  .filter-list { font: inherit; font-size: 14px; padding: 5px 10px; width: 360px; max-width: 100%; border: 1px solid var(--line);
                 border-radius: 6px; background: var(--bg); color: var(--fg); }
  details.ref-group > summary { cursor: pointer; list-style: none; }
  details.ref-group > summary::-webkit-details-marker { display: none; }
  details.ref-group > summary h2 { display: inline-block; margin: 20px 0 8px; }
  details.ref-group > summary h2::before { content: ""; display: inline-block; width: 6px; height: 6px; margin: 0 10px 3px 2px;
                                           border: solid var(--muted); border-width: 0 2px 2px 0; transform: rotate(-45deg); transition: transform .1s; }
  details.ref-group[open] > summary h2::before { transform: rotate(45deg); }
  .ref-row { display: flex; gap: 10px; align-items: baseline; padding: 8px 16px; border-bottom: 1px solid var(--line); font-size: 14px; min-width: 0; }
  .ref-row:last-child { border-bottom: 0; }
  .ref-row:hover { background: var(--meta-bg); }
  .ref-row .branch-name { font-weight: 600; white-space: nowrap; }
  .ref-row a { text-decoration: none; }
  .ref-row a:hover { text-decoration: underline; }
  .ref-row .subject { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; font-size: 13px; }
  .ref-row .who, .ref-row .when { white-space: nowrap; font-size: 13px; }
  /* Compare. */
  .compare-form { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 0 0 16px; font-size: 14px; }
  .compare-form label { display: inline-flex; gap: 6px; align-items: center; color: var(--muted); }
  .compare-form input { font: 13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; padding: 4px 8px; width: 220px;
                        border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }
  /* Search. */
  .search-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 0 0 8px; }
  .search-form input[type=search] { flex: 1; min-width: 240px; font: inherit; padding: 5px 10px; border: 1px solid var(--line);
                                    border-radius: 6px; background: var(--bg); color: var(--fg); }
  .search-form input[type=text] { min-width: 180px; }
  .search-form .check { font-size: 13px; display: inline-flex; gap: 4px; align-items: center; }
  .result .box-head { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  table.grep, table.blame { border-collapse: collapse; width: 100%; font: 12px/20px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  table.grep td, table.blame td { border: 0; padding: 0 10px; vertical-align: top; }
  td.num { width: 1%; text-align: right; color: var(--muted); user-select: none; white-space: nowrap; }
  td.num a { color: inherit; text-decoration: none; }
  td.num a:hover { color: var(--accent); }
  td.code { white-space: pre-wrap; overflow-wrap: anywhere; tab-size: 4; }
  .more-matches { padding: 4px 16px; font-size: 12px; border-top: 1px solid var(--line); }
  table.grep mark { background: color-mix(in srgb, var(--warn) 35%, transparent); color: inherit; border-radius: 2px; }
  /* Blame: the commit beside each run of lines it last changed, its age a
     stripe from orange (new) to grey (old). */
  table.blame tr.hunk-start td { border-top: 1px solid var(--line); }
  @media (prefers-color-scheme: dark) { table.blame td.code span { color: var(--shiki-dark) !important; } }
  table.blame tr:first-child td { border-top: 0; }
  table.blame td.who { width: 340px; max-width: 340px; padding: 0 10px 0 12px; font: 12px/20px system-ui, -apple-system, "Segoe UI", sans-serif;
                       border-left: 3px solid; border-right: 1px solid var(--line); }
  .blame-commit { display: flex; gap: 8px; align-items: baseline; white-space: nowrap; position: sticky; top: 0; }
  .blame-commit .subject { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--fg); text-decoration: none; }
  .blame-commit .subject:hover { color: var(--accent); text-decoration: underline; }
  .blame-commit .who-name { color: var(--muted); max-width: 90px; overflow: hidden; text-overflow: ellipsis; }
  .blame-commit .reblame { color: var(--muted); line-height: 0; }
  .blame-commit .reblame:hover { color: var(--accent); }
  table.blame tr:target td.code, table.blame tr:target td.num, table.grep tr:target td { background: color-mix(in srgb, var(--warn) 20%, transparent); }
  td.age0 { border-left-color: #fb8f44 !important; } td.age1 { border-left-color: #f0883e !important; }
  td.age2 { border-left-color: #db6d28 !important; } td.age3 { border-left-color: #bd561d !important; }
  td.age4 { border-left-color: #9b4215 !important; } td.age5 { border-left-color: #8b949e !important; }
  td.age6 { border-left-color: #6e7781 !important; } td.age7 { border-left-color: #57606a !important; }
  td.age8 { border-left-color: #424a53 !important; } td.age9 { border-left-color: #32383f !important; }
  /* Rendered markdown (assets/browse.js), in the manner of GitHub's. */
  .markdown-body { padding: 24px 32px; font-size: 15px; line-height: 1.6; overflow-wrap: break-word; }
  .markdown-body > :first-child { margin-top: 0 !important; }
  .markdown-body > :last-child { margin-bottom: 0 !important; }
  .markdown-body pre.md-source { white-space: pre-wrap; margin: 0; }
  .markdown-body h1, .markdown-body h2 { padding-bottom: .3em; border-bottom: 1px solid var(--line); }
  .markdown-body h1 { font-size: 2em; margin: 24px 0 16px; }
  .markdown-body h2 { font-size: 1.5em; margin: 24px 0 16px; }
  .markdown-body h3 { font-size: 1.25em; margin: 24px 0 16px; }
  .markdown-body h4, .markdown-body h5, .markdown-body h6 { font-size: 1em; margin: 24px 0 16px; }
  .markdown-body :is(h1, h2, h3, h4, h5, h6) { position: relative; line-height: 1.25; }
  .markdown-body .anchor { position: absolute; left: -22px; padding-right: 4px; color: var(--muted); text-decoration: none; opacity: 0; font-weight: 400; }
  .markdown-body :is(h1, h2, h3, h4, h5, h6):hover .anchor { opacity: 1; }
  .markdown-body p, .markdown-body ul, .markdown-body ol, .markdown-body blockquote, .markdown-body table, .markdown-body pre, .markdown-body details { margin: 0 0 16px; }
  .markdown-body ul, .markdown-body ol { padding-left: 2em; }
  .markdown-body li + li { margin-top: .25em; }
  .markdown-body code { font-size: 85%; padding: .2em .4em; border: 0; border-radius: 6px; background: color-mix(in srgb, var(--muted) 18%, transparent); }
  .markdown-body pre { padding: 16px; overflow: auto; border-radius: 6px; background: var(--meta-bg); line-height: 1.45; }
  .markdown-body pre code { padding: 0; background: none; font-size: 13px; }
  .markdown-body blockquote { padding: 0 1em; color: var(--muted); border-left: .25em solid var(--line); }
  .markdown-body table { width: auto; display: block; overflow: auto; }
  .markdown-body table th, .markdown-body table td { padding: 6px 13px; border: 1px solid var(--line); text-transform: none; letter-spacing: 0; font-size: 14px; color: var(--fg); }
  .markdown-body table tr:nth-child(2n) td { background: var(--meta-bg); }
  .markdown-body img { max-width: 100%; }
  .markdown-body a.ext-img { display: inline-block; font-size: 12px; padding: 0 6px; border: 1px dashed var(--line); border-radius: 4px; color: var(--muted); }
  .markdown-body hr { height: 4px; border: 0; background: var(--line); margin: 24px 0; }
  .markdown-body input[type=checkbox] { margin: 0 .3em 0 -1.3em; vertical-align: middle; }
  .markdown-body li:has(> input[type=checkbox]) { list-style: none; }
  /* The file finder and the shortcuts list: a dialog over the page. */
  dialog.overlay { width: min(680px, calc(100% - 32px)); max-height: min(70vh, 600px); margin: 10vh auto auto; padding: 0;
                   border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--fg);
                   box-shadow: 0 16px 48px rgb(0 0 0 / .3); overflow: hidden; display: none; flex-direction: column; }
  dialog.overlay[open] { display: flex; }
  dialog.overlay::backdrop { background: rgb(0 0 0 / .35); }
  dialog.overlay input.find { font: inherit; font-size: 16px; padding: 12px 16px; border: 0; border-bottom: 1px solid var(--line);
                              background: var(--bg); color: var(--fg); outline: none; }
  dialog.overlay ul { list-style: none; margin: 0; padding: 6px; overflow-y: auto; }
  dialog.overlay li a { display: flex; gap: 8px; align-items: center; padding: 6px 10px; border-radius: 6px; color: var(--fg); text-decoration: none;
                        font: 13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  dialog.overlay li a[aria-selected="true"] { background: var(--hunk-bg); outline: 1px solid var(--accent); }
  dialog.overlay li a b { color: var(--accent); }
  dialog.overlay .foot { padding: 6px 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
  dialog.overlay table.keys { margin: 8px 16px 16px; width: auto; }
  dialog.overlay table.keys td { border: 0; padding: 4px 12px 4px 0; font-size: 14px; }
  dialog.overlay h2 { margin: 16px 16px 0; }
  .toast { position: fixed; z-index: 30; left: 50%; bottom: 24px; transform: translateX(-50%); padding: 6px 14px; border-radius: 8px;
           background: var(--fg); color: var(--bg); font-size: 13px; pointer-events: none; }
  @media (max-width: 700px) {
    .code-search input, .code-search input:focus { width: 100%; }
    .code-search { flex: 1; }
    .code-search .hint { display: none; }
    .last-commit .who, .last-commit .when { display: none; }
    .ref-row .who, .ref-row .subject { display: none; }
    table.blame td.who { width: 120px; max-width: 120px; }
    .blame-commit .when, .blame-commit .who-name { display: none; }
    .markdown-body { padding: 16px; }
  }
  details.add { margin-top: 24px; }
  details.add summary { cursor: pointer; color: var(--accent); }
  /* Shown over a branch or commit page whose branch has moved. Fixed, so it
     is seen from anywhere in a long diff. */
  .panel.outdated { position: fixed; z-index: 10; left: 50%; bottom: 16px; transform: translateX(-50%); margin: 0;
                    width: max-content; max-width: calc(100% - 32px); background: var(--bg);
                    box-shadow: 0 4px 16px rgb(0 0 0 / .2); }
  .panel.outdated button { margin-left: 8px; }
</style>
</head>
<body>
<header><div class="in">
  <a class="brand" href="/"><svg class="logo" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path fill="var(--ok)" d="M3 7h4V3h4v4h4v4h-4v4H7v-4H3z"/><path fill="var(--bad)" d="M18 7h11v4H18z"/><path fill="currentColor" fill-rule="evenodd" d="M2 18h7v3h14v-3h7v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3zm3 3v7h22v-4h-1a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3H5z"/></svg><div>outbox <span>— review before push</span></div></a>
  <span class="spacer"></span>
  <button type="button" class="keys-help" data-shortcuts title="Keyboard shortcuts (?)" aria-label="Keyboard shortcuts"><kbd>?</kbd></button>
</div></header>
<main<% if @seq %> data-live data-seq="<%= @seq %>"<% if @repo %> data-repo="<%= h @repo.name %>"<% end %><% if @branch %> data-tips="<%= @branch.staged %> <%= @branch.upstream %>"<% end %><% end %>>
<%= yield %>
</main>
<script>
// Forms that do something hard to undo ask first. The question is data, not
// script: it can hold a branch name, which is the pusher's.
document.addEventListener("submit", function (e) {
  var question = e.target.getAttribute("data-confirm");
  if (question && !confirm(question)) e.preventDefault();
});

// Live pages (App#live!) follow what happens elsewhere: pushes, jobs, other
// tabs. GET /events names each repository that changes (Notifier); the
// index cares about all of them, a repository's pages about their own. On
// one, the page fetches itself again, a burst of them collapsing into one
// fetch, and then:
//
// - The index and a repository's page swap in the new <main>, keeping open
//   <details> as they were.
// - A branch page, and a commit page, never change under the reader: what
//   is approved is what was reviewed. If the branch has moved
//   (data-tips) or the page is gone, a notice says so and offers a reload,
//   and the page's approve and discard buttons are disabled. These pages
//   only look when refs may have moved, not at every progress line.
//
// A hidden tab closes its stream, since a browser allows only a few
// connections to one host over HTTP/1.1, and opens it again when shown. So
// does a page being left, so that it can be kept and brought back (the
// back/forward cache), and it opens a new one when it is. Each time a
// stream opens, the server says how many changes it has sent (seq); if
// that is not what the page last saw, it missed some, and catches up with a
// fetch.
(function () {
  var main = document.querySelector("main[data-live]");
  if (!main || !window.EventSource) return;
  var repo = main.getAttribute("data-repo");
  var tips = main.getAttribute("data-tips");
  var seen = main.getAttribute("data-seq");
  var source = null, timer = null, fetching = false, again = false, stale = false;
  // When the last fetch finished. The next waits at least SPACING after it,
  // so a repository reporting progress several times a second has the page
  // fetching itself about once a second, not as fast as the server answers.
  var settled = 0, SPACING = 1000;

  function schedule(delay) {
    if (fetching) again = true;
    else if (!timer && !stale) timer = setTimeout(refresh, Math.max(delay, settled + SPACING - Date.now()));
  }

  async function refresh() {
    timer = null;
    fetching = true;
    again = false;
    try {
      var res = await fetch(location.href, { headers: { "X-Requested-With": "live" } });
      if (res.status === 404) {
        outdated(tips ? "What this page shows is no longer staged here." : "This repository is gone.");
      } else if (res.ok && !res.redirected) {
        var next = new DOMParser().parseFromString(await res.text(), "text/html").querySelector("main");
        if (next && tips) {
          if (next.getAttribute("data-tips") !== tips) {
            var now = next.querySelector(".review .summary");
            outdated("This branch has changed since the page was loaded." + (now ? " Now: " + now.textContent.trim() + "." : ""));
          }
        } else if (next && next.innerHTML !== main.innerHTML) {
          var open = Array.from(main.querySelectorAll("details"), function (d) { return d.open; });
          main.innerHTML = next.innerHTML;
          main.querySelectorAll("details").forEach(function (d, i) { if (i < open.length) d.open = open[i]; });
          document.dispatchEvent(new CustomEvent("outbox:swap"));
        }
      }
    } catch (e) { /* offline or restarting; the stream reconnects and catches up */ }
    fetching = false;
    settled = Date.now();
    if (again) schedule(0);
  }

  function outdated(message) {
    stale = true;
    disconnect();
    main.querySelectorAll('form[action$="/approve"] button, form[action$="/discard"] button').forEach(function (b) {
      b.disabled = true;
      b.title = "Reload to review what is staged now";
    });
    var note = document.createElement("div");
    note.className = "panel warn outdated";
    note.setAttribute("role", "status");
    note.textContent = message + " ";
    var reload = document.createElement("button");
    reload.type = "button";
    reload.textContent = "Reload";
    reload.addEventListener("click", function () { location.reload(); });
    note.appendChild(reload);
    document.body.appendChild(note);
  }

  function changed(e) {
    seen = e.lastEventId;
    if (repo && e.data !== repo) return;
    if (tips && e.type !== "refs") return;
    schedule(100);
  }

  function connect() {
    if (source || stale) return;
    source = new EventSource("/events");
    source.addEventListener("hello", function (e) {
      if (e.data !== seen) { seen = e.data; schedule(0); }
    });
    source.addEventListener("status", changed);
    source.addEventListener("refs", changed);
  }

  function disconnect() {
    if (source) source.close();
    source = null;
  }

  document.addEventListener("visibilitychange", function () { document.hidden ? disconnect() : connect(); });
  window.addEventListener("pagehide", disconnect);
  window.addEventListener("pageshow", function () { if (!document.hidden) connect(); });
  if (!document.hidden) connect();
})();
</script>
<% if browse_built? %><script type="module" src="/diffs/browse.js"></script><% end %>
</body>
</html>
