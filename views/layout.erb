<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= @title ? "#{h @title} · outbox" : "outbox" %></title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Cstyle%3E.t%7Bfill:%231b1f23%7D@media(prefers-color-scheme:dark)%7B.t%7Bfill:%23c9d1d9%7D%7D%3C/style%3E%3Cpath fill=%27%2322863a%27 d=%27M3 7h4V3h4v4h4v4h-4v4H7v-4H3z%27/%3E%3Cpath fill=%27%23cb2431%27 d=%27M18 7h11v4H18z%27/%3E%3Cpath class=%27t%27 fill-rule=%27evenodd%27 d=%27M2 18h7v3h14v-3h7v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3zm3 3v7h22v-4h-1a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3H5z%27/%3E%3C/svg%3E">
<% if @refresh %><meta http-equiv="refresh" content="2"><% end %>
<style>
  :root {
    --bg: #ffffff; --fg: #1b1f23; --muted: #6a737d; --line: #e1e4e8;
    --accent: #0366d6; --ok: #22863a; --warn: #b08800; --bad: #cb2431;
    --add-bg: #e6ffed; --del-bg: #ffeef0; --hunk-bg: #f1f8ff; --meta-bg: #fafbfc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --fg: #c9d1d9; --muted: #8b949e; --line: #30363d;
      --accent: #58a6ff; --ok: #3fb950; --warn: #d29922; --bad: #f85149;
      --add-bg: #12261e; --del-bg: #2d1316; --hunk-bg: #161b22; --meta-bg: #161b22;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  header { border-bottom: 1px solid var(--line); padding: 0 16px; }
  header .in { max-width: 1100px; margin: 0 auto; display: flex; gap: 16px; align-items: baseline; height: 48px; }
  header a.brand { font-weight: 700; color: var(--fg); text-decoration: none; }
  header a.brand span { color: var(--muted); font-weight: 400; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
  a { color: var(--accent); }
  h1 { font-size: 22px; margin: 0 0 16px; }
  h2 { font-size: 17px; margin: 32px 0 8px; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  code { background: var(--meta-bg); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .muted { color: var(--muted); }
  .badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px;
           border: 1px solid currentColor; white-space: nowrap; }
  .badge.synced   { color: var(--muted); }
  .badge.ready    { color: var(--ok); }
  .badge.new      { color: var(--accent); }
  .badge.deleted  { color: var(--bad); }
  .badge.diverged { color: var(--warn); }
  .badge.syncing  { color: var(--accent); }
  .badge.failed   { color: var(--bad); }
  .progress { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  form.inline { display: inline; }
  button { font: inherit; font-size: 13px; padding: 4px 10px; border-radius: 6px; cursor: pointer;
           border: 1px solid var(--line); background: var(--meta-bg); color: var(--fg); }
  button.primary { background: var(--ok); border-color: var(--ok); color: #fff; }
  button.danger  { color: var(--bad); }
  button.warn    { background: var(--warn); border-color: var(--warn); color: #fff; }
  button:disabled { opacity: .5; cursor: default; }
  input[type=text], input[type=url] { font: inherit; padding: 5px 8px; border: 1px solid var(--line);
           border-radius: 6px; background: var(--bg); color: var(--fg); min-width: 240px; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  .toolbar .spacer { flex: 1; }
  .panel { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
  .panel.warn { border-color: var(--warn); }
  .panel.danger { border-color: var(--bad); }
  pre.diff { margin: 0; border: 1px solid var(--line); border-radius: 8px; overflow-x: auto;
             padding: 0; background: var(--bg); }
  pre.diff span { display: block; padding: 0 12px; white-space: pre; }
  pre.diff .add  { background: var(--add-bg); }
  pre.diff .del  { background: var(--del-bg); }
  pre.diff .hunk { background: var(--hunk-bg); color: var(--muted); }
  pre.diff .meta { background: var(--meta-bg); color: var(--muted); font-weight: 600; }
  .commit .subject { font-weight: 600; }
  .commit .who { color: var(--muted); font-size: 13px; }
  .empty { color: var(--muted); padding: 24px 0; }
  details.add { margin-top: 24px; }
  details.add summary { cursor: pointer; color: var(--accent); }
  details.add form { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
</style>
</head>
<body>
<header><div class="in">
  <a class="brand" href="/">outbox <span>— review before push</span></a>
</div></header>
<main>
<%= yield %>
</main>
</body>
</html>
