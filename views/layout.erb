<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= @title ? "#{h @title} · outbox" : "outbox" %></title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Cstyle%3E.t%7Bfill:%231b1f23%7D@media(prefers-color-scheme:dark)%7B.t%7Bfill:%23c9d1d9%7D%7D%3C/style%3E%3Cpath fill=%27%2322863a%27 d=%27M3 7h4V3h4v4h4v4h-4v4H7v-4H3z%27/%3E%3Cpath fill=%27%23cb2431%27 d=%27M18 7h11v4H18z%27/%3E%3Cpath class=%27t%27 fill-rule=%27evenodd%27 d=%27M2 18h7v3h14v-3h7v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3zm3 3v7h22v-4h-1a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3H5z%27/%3E%3C/svg%3E">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)">
<%# Basic auth: the manifest is fetched without credentials unless asked to. %>
<link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">
<link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png">
<script>if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js");</script>
<style>
  :root {
    --bg: #ffffff; --fg: #1b1f23; --muted: #6a737d; --line: #e1e4e8;
    --accent: #0366d6; --ok: #22863a; --warn: #b08800; --bad: #cb2431;
    --add-bg: #e6ffed; --del-bg: #ffeef0; --hunk-bg: #f1f8ff; --meta-bg: #fafbfc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --fg: #c9d1d9; --muted: #8b949e; --line: #30363d;
      --accent: #58a6ff; --ok: #3fb950; --warn: #d29922; --bad: #f85149;
      --add-bg: #12261e; --del-bg: #2d1316; --hunk-bg: #161b22; --meta-bg: #161b22;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  header { border-bottom: 1px solid var(--line); padding: 0 16px; }
  header .in { max-width: 1100px; margin: 0 auto; display: flex; gap: 16px; align-items: center; height: 48px; }
  header a.brand { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--fg); text-decoration: none; }
  header a.brand span { color: var(--muted); font-weight: 400; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
  a { color: var(--accent); }
  h1 { font-size: 22px; margin: 0 0 16px; }
  /* Title row: the heading, then whatever acts on the whole page. */
  .page-head { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin: 0 0 16px; }
  .page-head h1 { margin: 0; flex: 1; min-width: 0; }
  h1 .crumb { color: var(--muted); font-weight: 400; text-decoration: none; }
  h1 .crumb:hover { text-decoration: underline; }
  h1 .sep { color: var(--muted); font-weight: 400; margin: 0 8px; }
  h2 { font-size: 17px; margin: 32px 0 8px; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  code { background: var(--meta-bg); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  ul.repos, ul.branches { list-style: none; margin: 0; padding: 0; }
  li.repo { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 0 0 10px; }
  li.repo.pending { border-left: 4px solid var(--accent); }
  .repo-head { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .repo-head .spacer { flex: 1; }
  /* Repos with nothing to review: a plain list, not a card each. */
  ul.repos.idle li.repo { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap;
                          border: 0; border-bottom: 1px solid var(--line); border-radius: 0; padding: 8px 0; margin: 0; }
  ul.repos.idle li.repo:last-child { border-bottom: 0; }
  ul.repos.idle .spacer { flex: 1; }
  ul.repos.idle .repo-name { font-size: 15px; }
  .repo-name { font-size: 16px; font-weight: 600; }
  /* One grid for the whole list, so the badges, names and summaries line
     up down the card however wide each badge is. */
  ul.branches { display: grid; grid-template-columns: max-content max-content minmax(0, 1fr);
                gap: 5px 12px; align-items: baseline; margin-top: 10px; }
  ul.branches li { display: contents; }
  ul.branches .badge { justify-self: start; }
  .branch-name { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  .muted { color: var(--muted); }
  .badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px;
           border: 1px solid currentColor; white-space: nowrap; }
  .badge.synced   { color: var(--muted); }
  .badge.ready    { color: var(--ok); }
  .badge.new      { color: var(--accent); }
  .badge.deleted  { color: var(--bad); }
  .badge.diverged { color: var(--warn); }
  .badge.busy     { color: var(--accent); }
  .badge.failed   { color: var(--bad); }
  .progress { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; margin-top: 6px; }
  form.inline { display: inline; }
  button { font: inherit; font-size: 13px; padding: 4px 10px; border-radius: 6px; cursor: pointer;
           border: 1px solid var(--line); background: var(--meta-bg); color: var(--fg); }
  button.primary { background: var(--ok); border-color: var(--ok); color: #fff; }
  button.danger  { color: var(--bad); }
  button.warn    { background: var(--warn); border-color: var(--warn); color: #fff; }
  button:disabled { opacity: .5; cursor: default; }
  input[type=text], input[type=url] { font: inherit; padding: 5px 8px; border: 1px solid var(--line);
           border-radius: 6px; background: var(--bg); color: var(--fg); min-width: 240px; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  .toolbar .spacer { flex: 1; }
  .panel { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
  .panel.warn { border-color: var(--warn); }
  .panel.danger { border-color: var(--bad); }
  /* A branch's standing against upstream, with what can be done about it.
     The stripe takes the status colour, like the badge in the title. */
  .review { display: flex; gap: 16px 24px; align-items: center; justify-content: space-between; flex-wrap: wrap;
            margin: 0 0 8px; border-left: 4px solid var(--muted); }
  .review.ready    { border-left-color: var(--ok); }
  .review.new      { border-left-color: var(--accent); }
  .review.deleted  { border-left-color: var(--bad); }
  .review.diverged { border-left-color: var(--warn); }
  .review .state { min-width: 0; }
  .review .summary { font-weight: 600; }
  .review .summary::first-letter { text-transform: uppercase; }
  .review .detail { font-size: 13px; margin-top: 2px; }
  .review .note { font-size: 13px; color: var(--warn); margin-top: 2px; }
  .patch-summary { border: 1px solid var(--line); border-radius: 8px; padding: 10px 16px; margin: 0 0 16px; }
  .patch-summary ul { list-style: none; margin: 6px 0 0; padding: 0; columns: 2; column-gap: 24px; }
  .patch-summary li { break-inside: avoid; padding: 1px 0; }
  .count { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; }
  .count.add { color: var(--ok); }
  .count.del { color: var(--bad); }
  .badge.added   { color: var(--ok); }
  .badge.deleted { color: var(--bad); }
  .badge.renamed, .badge.copied { color: var(--accent); }
  details.file { border: 1px solid var(--line); border-radius: 8px; margin: 0 0 12px; }
  details.file > summary { cursor: pointer; padding: 8px 12px; background: var(--meta-bg);
                           display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  details.file > summary { position: sticky; top: 0; z-index: 2; }
  details.file { overflow: clip; }
  .diff-controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 0 0 12px; }
  .diff-controls .seg { display: inline-flex; }
  .diff-controls .seg button:first-child { border-radius: 6px 0 0 6px; }
  .diff-controls .seg button:last-child { border-radius: 0 6px 6px 0; margin-left: -1px; }
  .diff-controls button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  details.file > summary code { border: 0; background: none; padding: 0; font-weight: 600; }
  .badge.hidden { color: #fff; background: var(--bad); border-color: var(--bad); }
  /* Diff bodies are drawn by the browser bundle; until it runs, or if it
     cannot, the placeholder shows its text. */
  details.file .diff { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; }
  details.file .diff:empty { min-height: 40px; }
  details.file .diff > noscript, details.file .diff > a { padding: 8px 12px; font: 14px/1.5 system-ui, sans-serif; }
  pre.message { background: var(--meta-bg); border: 1px solid var(--line); border-radius: 8px;
                padding: 12px 16px; white-space: pre-wrap; margin: 0 0 16px; }
  details.more { display: inline; }
  details.more > summary.ellipsis { display: inline-block; cursor: pointer; list-style: none; user-select: none;
                                    font-size: 12px; line-height: 1; padding: 1px 8px 4px; margin-left: 6px;
                                    border-radius: 6px; background: var(--line); color: var(--muted); vertical-align: middle; }
  details.more > summary.ellipsis::-webkit-details-marker { display: none; }
  details.more > summary.ellipsis:hover, details.more[open] > summary.ellipsis { background: var(--accent); color: #fff; }
  details.more > pre.message { margin: 8px 0 4px 0; font-size: 12.5px; color: var(--muted); }
  /* The commit list on a branch: oldest at the bottom, resting on the commit
     it builds on, so which way is back in time never needs saying. */
  .history { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .history .commit { display: grid; grid-template-columns: 24px minmax(0, 1fr) 120px; column-gap: 12px;
                     padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .history .commit:last-child { border-bottom: 0; }
  .history .rail { grid-row: 1 / span 2; position: relative; }
  .history .rail::before { content: ""; position: absolute; left: 11px; top: -11px; bottom: -11px; width: 2px; background: var(--accent); }
  .history .commit:first-child .rail::before { top: 12px; }
  .history .rail::after { content: ""; position: absolute; left: 5px; top: 6px; width: 14px; height: 14px; box-sizing: border-box;
                          border: 2px solid var(--accent); border-radius: 50%; background: var(--bg); }
  .history .title { grid-column: 2; min-width: 0; }
  .history .meta { grid-column: 2; min-height: 36px; font-size: 12.5px; line-height: 18px; color: var(--muted); }
  .history .line { display: grid; grid-template-columns: 92px minmax(0, 380px) auto; white-space: nowrap; }
  .history .name { overflow: hidden; text-overflow: ellipsis; padding-right: 14px; }
  .history .name i { font-style: italic; }
  .history .committer { color: var(--warn); }
  .history .hash { background: none; border: 0; padding: 0; color: var(--muted); font-size: 12.5px; }
  .history .when { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; }
  .history .off { opacity: .55; }
  .history .size { grid-column: 3; grid-row: 1 / span 2; align-self: center; font-size: 12px; }
  .history .bar { display: flex; height: 6px; margin-bottom: 3px; border-radius: 3px; overflow: hidden; background: var(--line); }
  .history .bar i { display: block; height: 100%; }
  .history .bar .before { background: var(--muted); opacity: .45; }
  .history .bar .share { background: var(--accent); }
  .history .commit.base { background: color-mix(in srgb, var(--ok) 10%, var(--bg)); }
  .history .commit.base .title { font-weight: 600; }
  .history .commit.base .meta { min-height: 0; }
  .history .commit.base .rail::before, .history .commit.stub .rail::before { background: var(--ok); width: 6px; left: 9px; }
  .history .commit.base .rail::after { border-color: var(--ok); background: var(--ok); border-radius: 3px; left: 5px; }
  .history .commit.stub { background: color-mix(in srgb, var(--ok) 6%, var(--bg)); padding-top: 6px; padding-bottom: 6px; }
  .history .commit.stub .rail::after { display: none; }
  .history .commit.stub .rail::before { bottom: 0; }
  .history .commit.stub b { color: var(--ok); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  /* Commits upstream has that approving removes: the same rows, in red. */
  .history.dropped { border-color: var(--bad); }
  .history.dropped .rail::before { background: var(--bad); }
  .history.dropped .rail::after { border-color: var(--bad); }
  .history.dropped .bar .share { background: var(--bad); }
  .invis { background: var(--bad); color: #fff; font-size: 10px; font-weight: 700; padding: 0 4px;
           border-radius: 3px; margin: 0 1px; vertical-align: middle; }
  .badge.merge { color: var(--warn); margin-left: 6px; }
  .badge.tip { color: var(--accent); margin-left: 6px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 400; text-decoration: none; }
  .commit .subject { font-weight: 600; color: var(--fg); text-decoration: none; }
  .commit .subject:hover { text-decoration: underline; }
  .empty { color: var(--muted); padding: 24px 0; }
  details.add { margin-top: 24px; }
  details.add summary { cursor: pointer; color: var(--accent); }
  /* Shown over a branch or commit page whose branch has moved. Fixed, so it
     is seen from anywhere in a long diff. */
  .panel.outdated { position: fixed; z-index: 10; left: 50%; bottom: 16px; transform: translateX(-50%); margin: 0;
                    width: max-content; max-width: calc(100% - 32px); background: var(--bg);
                    box-shadow: 0 4px 16px rgb(0 0 0 / .2); }
  .panel.outdated button { margin-left: 8px; }
</style>
</head>
<body>
<header><div class="in">
  <a class="brand" href="/"><svg class="logo" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path fill="var(--ok)" d="M3 7h4V3h4v4h4v4h-4v4H7v-4H3z"/><path fill="var(--bad)" d="M18 7h11v4H18z"/><path fill="currentColor" fill-rule="evenodd" d="M2 18h7v3h14v-3h7v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3zm3 3v7h22v-4h-1a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3H5z"/></svg><div>outbox <span>— review before push</span></div></a>
</div></header>
<main<% if @seq %> data-live data-seq="<%= @seq %>"<% if @repo %> data-repo="<%= h @repo.name %>"<% end %><% if @branch %> data-tips="<%= @branch.staged %> <%= @branch.upstream %>"<% end %><% end %>>
<%= yield %>
</main>
<script>
// Live pages (App#live!) follow what happens elsewhere: pushes, jobs, other
// tabs. GET /events names each repository that changes (Notifier); the
// index cares about all of them, a repository's pages about their own. On
// one, the page fetches itself again, a burst of them collapsing into one
// fetch, and then:
//
// - The index and a repository's page swap in the new <main>, keeping open
//   <details> as they were.
// - A branch page, and a commit page, never change under the reader: what
//   is approved is what was reviewed. If the branch has moved
//   (data-tips) or the page is gone, a notice says so and offers a reload,
//   and the page's approve and discard buttons are disabled. These pages
//   only look when refs may have moved, not at every progress line.
//
// A hidden tab closes its stream, since a browser allows only a few
// connections to one host over HTTP/1.1, and opens it again when shown. So
// does a page being left, so that it can be kept and brought back (the
// back/forward cache), and it opens a new one when it is. Each time a
// stream opens, the server says how many changes it has sent (seq); if
// that is not what the page last saw, it missed some, and catches up with a
// fetch.
(function () {
  var main = document.querySelector("main[data-live]");
  if (!main || !window.EventSource) return;
  var repo = main.getAttribute("data-repo");
  var tips = main.getAttribute("data-tips");
  var seen = main.getAttribute("data-seq");
  var source = null, timer = null, fetching = false, again = false, stale = false;
  // When the last fetch finished. The next waits at least SPACING after it,
  // so a repository reporting progress several times a second has the page
  // fetching itself about once a second, not as fast as the server answers.
  var settled = 0, SPACING = 1000;

  function schedule(delay) {
    if (fetching) again = true;
    else if (!timer && !stale) timer = setTimeout(refresh, Math.max(delay, settled + SPACING - Date.now()));
  }

  async function refresh() {
    timer = null;
    fetching = true;
    again = false;
    try {
      var res = await fetch(location.href, { headers: { "X-Requested-With": "live" } });
      if (res.status === 404) {
        outdated(tips ? "What this page shows is no longer staged here." : "This repository is gone.");
      } else if (res.ok && !res.redirected) {
        var next = new DOMParser().parseFromString(await res.text(), "text/html").querySelector("main");
        if (next && tips) {
          if (next.getAttribute("data-tips") !== tips) {
            var now = next.querySelector(".review .summary");
            outdated("This branch has changed since the page was loaded." + (now ? " Now: " + now.textContent.trim() + "." : ""));
          }
        } else if (next && next.innerHTML !== main.innerHTML) {
          var open = Array.from(main.querySelectorAll("details"), function (d) { return d.open; });
          main.innerHTML = next.innerHTML;
          main.querySelectorAll("details").forEach(function (d, i) { if (i < open.length) d.open = open[i]; });
        }
      }
    } catch (e) { /* offline or restarting; the stream reconnects and catches up */ }
    fetching = false;
    settled = Date.now();
    if (again) schedule(0);
  }

  function outdated(message) {
    stale = true;
    disconnect();
    main.querySelectorAll('form[action$="/approve"] button, form[action$="/discard"] button').forEach(function (b) {
      b.disabled = true;
      b.title = "Reload to review what is staged now";
    });
    var note = document.createElement("div");
    note.className = "panel warn outdated";
    note.setAttribute("role", "status");
    note.textContent = message + " ";
    var reload = document.createElement("button");
    reload.type = "button";
    reload.textContent = "Reload";
    reload.addEventListener("click", function () { location.reload(); });
    note.appendChild(reload);
    document.body.appendChild(note);
  }

  function changed(e) {
    seen = e.lastEventId;
    if (repo && e.data !== repo) return;
    if (tips && e.type !== "refs") return;
    schedule(100);
  }

  function connect() {
    if (source || stale) return;
    source = new EventSource("/events");
    source.addEventListener("hello", function (e) {
      if (e.data !== seen) { seen = e.data; schedule(0); }
    });
    source.addEventListener("status", changed);
    source.addEventListener("refs", changed);
  }

  function disconnect() {
    if (source) source.close();
    source = null;
  }

  document.addEventListener("visibilitychange", function () { document.hidden ? disconnect() : connect(); });
  window.addEventListener("pagehide", disconnect);
  window.addEventListener("pageshow", function () { if (!document.hidden) connect(); });
  if (!document.hidden) connect();
})();
</script>
</body>
</html>
