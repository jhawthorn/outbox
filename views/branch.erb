<% @title = "#{@repo.name} / #{@branch.name}" %>
<p class="muted"><a href="<%= repo_url(@repo) %>"><%= h @repo.name %></a> /</p>
<h1><%= h @branch.name %>
  <span class="badge <%= @branch.status %>"><%= status_label(@branch.status) %></span></h1>

<div class="toolbar">
  <span><%= h summary(@branch) %></span>
  <span class="muted">staged <code><%= short(@branch.staged) %></code> · upstream <code><%= short(@branch.upstream) %></code></span>
  <span class="spacer"></span>
  <form class="inline" method="post" action="<%= repo_url(@repo) %>/fetch">
    <input type="hidden" name="back" value="<%= h branch_url(@repo, @branch.name) %>">
    <button type="submit">Fetch upstream</button>
  </form>
</div>

<% if @branch.pending? %>
  <div class="panel <%= @branch.needs_force? ? "warn" : "" %>">
    <div class="actions">
      <% if @branch.needs_force? %>
        <form class="inline" method="post" action="<%= branch_url(@repo, @branch.name) %>/approve"
              onsubmit="return confirm('Force-push <%= h @branch.name %> to upstream? <%= @outgoing.size %> upstream commit(s) will be dropped.')">
          <input type="hidden" name="force" value="1">
          <input type="hidden" name="expected" value="<%= @branch.staged %>">
          <button type="submit" class="warn">Force approve</button>
        </form>
        <span class="muted">Upstream has moved. Approving overwrites it.</span>
      <% else %>
        <form class="inline" method="post" action="<%= branch_url(@repo, @branch.name) %>/approve">
          <input type="hidden" name="expected" value="<%= @branch.staged %>">
          <button type="submit" class="primary">Approve and push to upstream</button>
        </form>
      <% end %>
      <form class="inline" method="post" action="<%= branch_url(@repo, @branch.name) %>/discard"
            onsubmit="return confirm('Discard staged changes on <%= h @branch.name %>?')">
        <input type="hidden" name="expected" value="<%= @branch.staged %>">
        <button type="submit" class="danger">Discard</button>
      </form>
    </div>
  </div>
<% end %>

<% unless @outgoing.empty? %>
  <h2>Dropped from upstream (<%= @outgoing.size %>)</h2>
  <div class="panel danger">
    <% @outgoing.each do |c| %>
      <div class="commit"><code><%= c.short %></code> <span class="subject"><%= hv c.subject %></span>
        <% if c.body? %>
          <details class="more">
            <summary class="ellipsis" title="Show full commit message (<%= c.body_lines %> more line<%= c.body_lines == 1 ? "" : "s" %>)">…</summary>
            <pre class="message"><%= hv c.body %></pre>
          </details>
        <% end %>
        <div class="who"><%= identity_line(c) %></div></div>
    <% end %>
  </div>
<% end %>

<% unless @commits.empty? %>
  <h2>Commits (<%= @commits.size %>)</h2>
  <% @commits.each do |c| %>
    <div class="commit">
      <code><%= c.short %></code>
      <a class="subject" href="<%= commit_url(@repo, @branch.name, c) %>"><%= hv c.subject %></a>
      <% if c.body? %>
        <details class="more">
          <summary class="ellipsis" title="Show full commit message (<%= c.body_lines %> more line<%= c.body_lines == 1 ? "" : "s" %>)">…</summary>
          <pre class="message"><%= hv c.body %></pre>
        </details>
      <% end %>
      <% if c.merge? %><span class="badge merge">merge</span><% end %>
      <div class="who"><%= identity_line(c) %></div>
    </div>
  <% end %>
<% end %>

<% if @patch.empty? %>
  <% if @branch.status == :synced %><p class="empty">Nothing staged on this branch.</p><% end %>
<% else %>
  <h2>Files changed (<%= @patch.files.size %>)</h2>
  <%= render_patch(@patch) %>
<% end %>
