#!/usr/bin/env ruby
# frozen_string_literal: true
# Command-line access to the same operations as the web UI. Intended for use
# inside the container, as the user the server runs as:
#
#   podman compose exec -u outbox outbox bin/outbox list
#
require_relative "../lib/outbox/git"
require_relative "../lib/outbox/repo"
require_relative "../lib/outbox/config"

# As root, git refuses the data directory (owned by outbox) and anything
# created would be root-owned and unusable by the server.
if Process.euid.zero?
  warn "error: do not run as root; the data directory belongs to the server's user.\n" \
       "In the container: podman compose exec -u outbox outbox bin/outbox #{ARGV.join(" ")}"
  exit 1
end

# The CLI is its own process, so fetches here are synchronous and show git's
# progress on stderr.
def fetch_with_progress(repo)
  repo.fetch! { |line| $stderr.print "\r\e[K#{line}" }
  $stderr.puts
end

def usage
  warn <<~USAGE
    usage: outbox <command> [args]

      list                         list repositories and pending branches
      add <name> <upstream-url>    add a repository to the configuration, without review
      remove <name>                remove a repository and its staging repo (upstream untouched)
      fetch <name>                 fetch upstream
      approve <name> <branch>      push a staged branch to upstream (--force to overwrite)
      discard <name> <branch>      reset a staged branch back to upstream
  USAGE
  exit 1
end

cmd, *args = ARGV
force = args.delete("--force")

begin
  Outbox::Config.ensure!
  case cmd
  when "list"
    Outbox::Repo.all.each do |repo|
      puts "#{repo.name}  (#{repo.config? ? "configuration" : repo.upstream_url})"
      repo.branches.each do |b|
        puts format("  %-30s %-10s staged=%s upstream=%s", b.name, b.status, b.staged&.[](0, 10), b.upstream&.[](0, 10))
      end
    end
  when "add"
    usage unless args.size == 2
    Outbox::Config.add(*args)
    Outbox::Config.apply!.each do |repo|
      puts "added #{repo.name}"
      begin
        fetch_with_progress(repo)
      rescue Outbox::GitError => e
        warn "first fetch failed: #{e.message}"
        warn "check the URL and OUTBOX_UPSTREAM_TOKEN, then run: outbox fetch #{repo.name}"
      end
    end
  when "remove"
    usage unless args.size == 1
    Outbox::Config.remove(args[0])
  when "fetch"
    usage unless args.size == 1
    fetch_with_progress(Outbox::Repo.find!(args[0]))
  when "approve"
    usage unless args.size == 2
    Outbox::Repo.find!(args[0]).approve!(args[1], force: !force.nil?)
    puts "pushed #{args[1]} to upstream"
    Outbox::Config.apply!.each { |repo| fetch_with_progress(repo) } if args[0] == Outbox::Config::NAME
  when "discard"
    usage unless args.size == 2
    Outbox::Repo.find!(args[0]).discard!(args[1])
  else
    usage
  end
rescue Outbox::Error, ArgumentError => e
  warn "error: #{e.message}"
  exit 1
end
