#!/bin/sh
# Container entrypoint. Named volumes are created root-owned and may be
# initialised by another container, so fix the mountpoints' ownership
# (not recursively; outbox owns everything it creates) and drop to outbox.
set -e
chown outbox:outbox /data/repos /data/config.git
exec setpriv --reuid=outbox --regid=outbox --init-groups "$@"
