#!/usr/bin/env ruby
# frozen_string_literal: true

# Invoked by git as $GIT_SSH (which git executes directly, no shell). Runs
# ssh with exactly one identity, the repo's deploy key, and ignores the
# user's ssh config so nothing else can be picked up.
key = ENV.fetch("OUTBOX_SSH_KEY")
known_hosts = ENV.fetch("OUTBOX_KNOWN_HOSTS")

exec(
  "ssh",
  "-F", "/dev/null",
  "-i", key,
  "-o", "IdentitiesOnly=yes",
  "-o", "StrictHostKeyChecking=accept-new",
  "-o", "UserKnownHostsFile=#{known_hosts}",
  *ARGV,
)
